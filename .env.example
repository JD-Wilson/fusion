SITE_URL=https://fusionfc.co.uk
PUBLIC_WEB3FORMS_KEY=your_key_here

# Supabase → Project Settings → API. Powers vacancies, the manager portal and logins.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose or commit. Used to save enquiries, look up WhatsApp
# numbers when a parent taps the button, and invite managers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: email enquiries to managers (https://resend.com). Without it,
# enquiries are still saved in the portal inbox.
RESEND_API_KEY=
EMAIL_FROM="Fusion FC <website@fusionfc.co.uk>"
# Fallback inbox when a vacancy has no manager email (or set it in the database: club_private.inbox_email)
CLUB_INBOX_EMAIL=
