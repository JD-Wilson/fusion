---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSession } from '../lib/auth';
import { siteConfig, toAbsoluteUrl } from '../config/site';
import { sendEmail } from '../lib/email';
import { line } from '../lib/forms';
import type { TeamRow } from '../lib/portal';
import { groupOf, sortTeams } from '../lib/portal-overview';
import { TEAM_ROLES } from '../lib/portal-people';
import { parseSignupRequest, type SignupRequest } from '../lib/team-requests';
import { adminSupabase, isSupabaseConfigured, serverSupabase } from '../lib/supabase';
import { normaliseWhatsApp } from '../lib/vacancies';

export const prerender = false;

/*
 * Coaches create their own login here. No email is sent: the login is made on
 * the server and starts unapproved, so it can't see or change anything until a
 * club admin approves it in People and puts it on teams.
 */
Astro.response.headers.set('Cache-Control', 'private, no-store');

let error: string | null = null;
const values = { full_name: '', email: '', phone: '' };
// Which teams they help with, and their role: a note for the approving admin only.
let request: SignupRequest = { teams: [], other: null };
let teams: Pick<TeamRow, 'id' | 'name' | 'match_day' | 'kind'>[] = [];

/** Let the club inbox know someone is waiting for approval. A failed email never stops the sign-up. */
async function notifyClub(admin: NonNullable<ReturnType<typeof adminSupabase>>, userId: string) {
  const { data: person } = await admin.from('people').select('id').eq('user_id', userId).maybeSingle();
  const link = toAbsoluteUrl(person ? `/portal/people/${person.id}/` : '/portal/people/?show=pending');
  const names = new Map(teams.map((t) => [t.id, t.name]));
  const asked = request.teams.map((r) => `  - ${names.get(r.team_id)}: ${r.role}`);
  const lines: (string | null)[] = [
    `${values.full_name} has created a coach login on the Fusion FC website and is waiting for approval.`,
    '',
    `Email: ${values.email}`,
    values.phone ? `Mobile: ${values.phone}` : null,
    '',
    asked.length ? 'Teams they said they help with:' : "They didn't tick any teams.",
    ...asked,
    request.other ? `Also said: "${request.other}"` : null,
    '',
    "Check it's really them, then approve them and add them to their teams in People:",
    link
  ];
  await sendEmail({
    to: [siteConfig.clubContactEmail],
    subject: `[Fusion FC] New coach sign-up: ${values.full_name}`,
    replyTo: values.email,
    text: lines.filter((l) => l !== null).join('\n')
  });
}

if (isSupabaseConfigured) {
  const supabase = serverSupabase(Astro.request, Astro.cookies);
  const { data: teamData } = (await adminSupabase()?.from('teams').select('id, name, match_day, kind, published')) ?? { data: null };
  teams = sortTeams(((teamData ?? []) as (TeamRow & { published: boolean })[]).filter((t) => t.published || t.kind === 'development'));

  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    values.full_name = line(form, 'full_name', 80) ?? '';
    values.email = String(form.get('email') ?? '').trim().toLowerCase().slice(0, 200);
    values.phone = line(form, 'phone', 30) ?? '';
    const password = String(form.get('password') ?? '');
    const admin = adminSupabase();
    request = parseSignupRequest(form, new Set(teams.map((t) => t.id)));

    if (String(form.get('website') ?? '')) {
      error = 'Something went wrong. Please try again.'; // honeypot: bots fill every field
    } else if (!values.full_name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(values.email)) {
      error = 'Please enter your name and email address.';
    } else if (password.length < 8) {
      error = 'Please choose a password of at least 8 characters.';
    } else if (values.phone && !normaliseWhatsApp(values.phone)) {
      error = "That mobile number doesn't look right.";
    } else if (!admin) {
      error = "Sign-ups aren't switched on yet. Please ask a club admin.";
    } else {
      const { data, error: createError } = await admin.auth.admin.createUser({
        email: values.email,
        password,
        email_confirm: true,
        user_metadata: {
          full_name: values.full_name,
          self_signup: true,
          requested_teams: request.teams,
          requested_other: request.other
        }
      });
      if (createError || !data.user) {
        error = /already|registered|exists/i.test(createError?.message ?? '')
          ? 'That email already has a login. Sign in instead, or ask a club admin to set you a temporary password.'
          : 'Your login could not be created. Please try again.';
      } else {
        // Hold it until a club admin approves. If that can't be recorded, undo the sign-up.
        const { error: holdError } = await admin
          .from('profiles')
          .update({ approved: false, full_name: values.full_name, phone: values.phone || null })
          .eq('id', data.user.id);
        if (holdError) {
          await admin.auth.admin.deleteUser(data.user.id);
          error = "Sign-ups aren't switched on yet. Please ask a club admin.";
        } else {
          await notifyClub(admin, data.user.id);
          await supabase.auth.signInWithPassword({ email: values.email, password });
          return Astro.redirect('/portal/account/?signed_up=1');
        }
      }
    }
  } else if (await loadSession(supabase)) {
    return Astro.redirect('/portal/');
  }
}
---

<BaseLayout title="Create a coach login | Fusion FC" description="Create a login for the Fusion FC team hub." canonical="/signup/" noindex>
  <section class="login section-card">
    <img class="crest" src="/brand/logo.jpeg" alt="" width="56" height="56" />
    <p class="band-eyebrow">Fusion FC team hub</p>
    <h1 class="section-title">Create a coach login</h1>
    <p class="section-copy">For Fusion FC managers, coaches and helpers. Once a club admin has approved you and added you to your teams, you can update your team's page, vacancies and enquiries.</p>

    {!isSupabaseConfigured && <div class="msg bad">Logins aren't switched on yet. Supabase still needs connecting.</div>}
    {error && <div class="msg bad" role="alert">{error}</div>}

    <form method="post" class="stack">
      <label>Your name<input type="text" name="full_name" value={values.full_name} autocomplete="name" maxlength="80" required /></label>
      <label>Email<input type="email" name="email" value={values.email} autocomplete="email" maxlength="200" required /></label>
      <label>Mobile (optional)<input type="tel" name="phone" value={values.phone} autocomplete="tel" maxlength="30" placeholder="07700 900123" /></label>
      <label>
        Password
        <input type="password" name="password" autocomplete="new-password" minlength="8" required />
        <span class="hint">At least 8 characters.</span>
      </label>
      <fieldset class="teams">
        <legend>Your teams</legend>
        <p class="hint">Tick the teams you help with and your role on each. This tells the club admin which teams to add you to. It doesn't give you access on its own.</p>
        {[...new Set(teams.map(groupOf))].map((group) => (
          <div class="team-group">
            <h3>{group}</h3>
            {teams.filter((t) => groupOf(t) === group).map((t) => {
              const picked = request.teams.find((r) => r.team_id === t.id);
              return (
                <div class="team-pick" data-team-pick>
                  <label class="check"><input type="checkbox" name="team" value={t.id} checked={Boolean(picked)} />{t.name}</label>
                  <select name={`role_${t.id}`} aria-label={`Your role on ${t.name}`}>
                    {TEAM_ROLES.map((r) => <option value={r} selected={(picked?.role ?? 'Coach') === r}>{r}</option>)}
                  </select>
                </div>
              );
            })}
          </div>
        ))}
        <label>
          Team not listed, or anything else? (optional)
          <input type="text" name="teams_other" value={request.other ?? ''} maxlength="300" placeholder="e.g. New U9 team starting in January" />
        </label>
      </fieldset>
      <label class="hp" aria-hidden="true">Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      <button class="button primary" type="submit">Create login</button>
    </form>
    <p class="small">Already have a login? <a href="/login/">Sign in</a></p>
  </section>
</BaseLayout>

<script>
  // The role only matters for ticked teams.
  document.querySelectorAll<HTMLElement>('[data-team-pick]').forEach((row) => {
    const box = row.querySelector<HTMLInputElement>('input[name="team"]')!;
    const select = row.querySelector<HTMLSelectElement>('select')!;
    const sync = () => {
      row.classList.toggle('off', !box.checked);
      select.disabled = !box.checked;
    };
    box.addEventListener('change', sync);
    sync();
  });
</script>

<style>
  .login { max-width: 440px; margin: var(--space-xl) auto 0; }
  .crest { border-radius: 12px; margin-bottom: var(--space-s); }
  .stack { display: grid; gap: var(--space-s); margin-top: var(--space-m); }
  label { display: grid; gap: 0.3rem; font-size: 0.8rem; font-weight: 600; color: var(--color-muted); }
  input { font: inherit; font-size: 16px; padding: 0.7rem 0.85rem; border: 1px solid var(--line); border-radius: var(--radius-s); min-height: 46px; background: var(--surface-2); color: var(--text); }
  input:focus { outline: none; border-color: var(--accent-line); }
  .teams { border: 0; padding: 0; margin: 0; display: grid; gap: 0.4rem; min-width: 0; }
  .teams legend { padding: 0; font-size: 0.8rem; font-weight: 600; color: var(--color-muted); margin-bottom: 0.3rem; }
  .teams .hint { font-size: 0.8rem; margin: 0; }
  .team-group h3 { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); margin: 0.5rem 0 0.2rem; }
  .team-pick { display: grid; grid-template-columns: minmax(0, 1fr) 9.5rem; gap: 0.5rem; align-items: center; padding: 0.25rem 0; border-top: 1px solid var(--line); }
  .team-pick .check { display: flex; align-items: center; gap: 0.5rem; font-size: 0.92rem; font-weight: 500; color: var(--text); }
  .team-pick .check input { min-height: 0; width: 18px; height: 18px; padding: 0; }
  .team-pick select { font: inherit; font-size: 16px; min-height: 40px; padding: 0.3rem 0.5rem; border: 1px solid var(--line); border-radius: var(--radius-s); background: var(--surface-2); color: var(--text); }
  .team-pick.off select { opacity: 0.4; }
  .hint { font-weight: 400; color: var(--text-3); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .primary { border: 0; cursor: pointer; }
  .small { margin-top: var(--space-s); font-size: 0.9rem; color: var(--text-3); }
  .small a { color: var(--accent); }
  .msg { margin-top: var(--space-s); padding: 0.8rem 1rem; border-radius: var(--radius-s); font-size: 0.92rem; }
  .msg.bad { background: rgba(240, 90, 90, 0.1); border: 1px solid rgba(240, 90, 90, 0.35); color: #f5a3a3; }
</style>
