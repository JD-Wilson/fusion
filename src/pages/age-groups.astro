---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { createBreadcrumbJsonLd } from '../lib/seo';
import { requirePageEntry } from '../lib/pages';

const agePage = await requirePageEntry('age-groups');
const { Content } = await render(agePage);

const allTeams = (await getCollection('teams', ({ data }) => !data.noindex)).sort((a, b) => {
  const ageA = Number.parseInt(a.data.ageGroup.replace(/\D/g, ''), 10) || 99;
  const ageB = Number.parseInt(b.data.ageGroup.replace(/\D/g, ''), 10) || 99;
  if (ageA !== ageB) return ageA - ageB;
  return (a.data.teamName).localeCompare(b.data.teamName);
});

const saturdayTeams = allTeams.filter(t => t.data.matchday === 'Saturday');
const sundayTeams = allTeams.filter(t => t.data.matchday === 'Sunday');
const ungroupedTeams = allTeams.filter(t => !t.data.matchday);

const teamGroups = [
  { heading: 'Saturday Teams', teams: saturdayTeams },
  { heading: 'Sunday Teams', teams: sundayTeams },
  { heading: '', teams: ungroupedTeams }
].filter((group) => group.teams.length > 0);

const teamFilters = [
  { value: 'all', label: 'All' },
  { value: 'Saturday', label: 'Saturday' },
  { value: 'Sunday', label: 'Sunday' },
  { value: 'girls', label: 'Girls' }
];

// Long league names become initials on the chip (full name in the tooltip),
// e.g. "Staffordshire Junior Football League" -> "SJFL"
const shortLeagueName = (name: string) => {
  const words = name.split(/\s+/);
  return words.length >= 3 ? words.map((word) => word[0].toUpperCase()).join('') : name;
};

const seasons = [...new Set(allTeams.map((team) => team.data.season))];

const breadcrumbs = createBreadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: 'Age Groups', path: '/age-groups/' }
]);
---

<BaseLayout
  title={agePage.data.seoTitle ?? agePage.data.title}
  description={agePage.data.seoDescription ?? agePage.data.description}
  canonical={agePage.data.canonicalUrl ?? '/age-groups/'}
  image={agePage.data.ogImage}
  noindex={agePage.data.noindex}
  structuredData={[breadcrumbs]}
>
  <PageHero eyebrow="Player Pathways" title={agePage.data.title} summary={agePage.data.description} />

  <section class="section-card reveal" data-delay="1">
    <div class="prose">
      <Content />
    </div>
  </section>

  <section class="dark-band reveal" data-delay="2">
    <div class="band-head">
      <div>
        <p class="band-eyebrow">Registered Teams{seasons.length === 1 && ` · Season ${seasons[0]}`}</p>
        <h2 class="band-title">Current Team Groups</h2>
      </div>
      <a class="band-link" href="/leagues/">View leagues →</a>
    </div>

    <div class="team-filters" role="group" aria-label="Filter teams" hidden>
      {teamFilters.map((filter, i) => (
        <button type="button" class="filter-btn" data-filter={filter.value} aria-pressed={i === 0 ? 'true' : 'false'}>
          {filter.label}
        </button>
      ))}
    </div>

    {teamGroups.map((group) => (
      <div class="matchday-group" data-group>
        {group.heading && <h3 class="matchday-heading">{group.heading}</h3>}
        <div class="grid grid-3">
          {group.teams.map((team) => (
            <article
              class="dark-card team-card"
              data-matchday={team.data.matchday ?? ''}
              data-girls={/girls/i.test(team.data.teamName) ? 'true' : 'false'}
            >
              <span class="team-ghost" aria-hidden="true">{team.data.ageGroup}</span>
              <h3 class="team-name">{team.data.teamName}</h3>
              <p class="team-age-label">{team.data.ageGroup}</p>
              <div class="chip-list">
                <span class="chip" title={team.data.league}>{shortLeagueName(team.data.league)}</span>
              </div>
              {(team.data.training || team.data.coach) && (
                <div class="team-details">
                  {team.data.training && (
                    <div class="detail-item">
                      <span class="detail-label">Training</span>
                      <span class="detail-value">{team.data.training}</span>
                    </div>
                  )}
                  {team.data.coach && (
                    <div class="detail-item">
                      <span class="detail-label">Coach</span>
                      <span class="detail-value">{team.data.coach}</span>
                    </div>
                  )}
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>

<script>
  const filters = document.querySelector<HTMLElement>('.team-filters');
  if (filters) {
    filters.hidden = false;
    const buttons = filters.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.team-card');
    const groups = document.querySelectorAll<HTMLElement>('[data-group]');

    buttons.forEach((button) => button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      cards.forEach((card) => {
        const show =
          filter === 'all' ||
          (filter === 'girls' ? card.dataset.girls === 'true' : card.dataset.matchday === filter);
        card.hidden = !show;
      });
      groups.forEach((group) => {
        group.hidden = !group.querySelector('.team-card:not([hidden])');
      });
    }));
  }
</script>

<style>
  .team-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-l);
    position: relative;
  }

  .filter-btn {
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(245, 247, 246, 0.18);
    background: transparent;
    color: rgba(245, 247, 246, 0.8);
    cursor: pointer;
    transition: background var(--transition), border-color var(--transition), color var(--transition);
  }

  .filter-btn:hover {
    border-color: rgba(29, 185, 84, 0.6);
  }

  .filter-btn[aria-pressed='true'] {
    background: var(--color-lime);
    border-color: var(--color-lime);
    color: var(--color-ink);
  }

  .matchday-group[hidden],
  .team-card[hidden] {
    display: none;
  }

  .band-link {
    color: rgba(245, 247, 246, 0.62);
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color var(--transition);
  }

  .band-link:hover {
    color: var(--color-lime);
  }

  .team-card {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .team-ghost {
    position: absolute;
    bottom: -0.6rem;
    right: var(--space-s);
    font-family: var(--font-display);
    font-size: 3.8rem;
    font-weight: 700;
    color: rgba(29, 185, 84, 0.07);
    line-height: 1;
    letter-spacing: -0.02em;
    user-select: none;
    pointer-events: none;
  }

  .team-name {
    font-size: 1.15rem;
    color: var(--color-paper);
    position: relative;
    z-index: 1;
  }

  .team-age-label {
    font-family: var(--font-display);
    font-size: 0.72rem;
    color: rgba(245, 247, 246, 0.62);
  }

  .team-details {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.3rem;
  }

  .matchday-group {
    display: grid;
    gap: var(--space-m);
  }

  .matchday-group + .matchday-group {
    margin-top: var(--space-l);
  }

  .matchday-heading {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-lime);
    margin: 0;
  }
</style>
