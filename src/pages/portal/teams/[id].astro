---
import PortalLayout from '../../../components/portal/PortalLayout.astro';
import ResizeUploads from '../../../components/portal/ResizeUploads.astro';
import SponsorFields from '../../../components/portal/SponsorFields.astro';
import TeamFields from '../../../components/portal/TeamFields.astro';
import { siteConfig, toAbsoluteUrl } from '../../../config/site';
import { canEditTeam } from '../../../lib/auth';
import { sendEmail } from '../../../lib/email';
import { adminSupabase } from '../../../lib/supabase';
import { UUID, checked, line } from '../../../lib/forms';
import { countNewEnquiries, type TeamRow } from '../../../lib/portal';
import {
  parseAdminTeamFields,
  parseManagerTeamFields,
  saveTeamContact,
  uploadTeamPhoto
} from '../../../lib/portal-teams';
import type { VacancyRow } from '../../../lib/portal-vacancies';
import { TEAM_ROLES } from '../../../lib/portal-people';
import { positionsLabel } from '../../../lib/vacancies';
import { loadSponsorsForPortal, parseSponsorForm, removeSponsorLogo, uploadSponsorLogo, websiteLabel, type TeamSponsor } from '../../../lib/team-sponsors';

export const prerender = false;
const session = Astro.locals.session!;
const supabase = Astro.locals.supabase!;
const id = Astro.params.id ?? '';
if (!UUID.test(id) || !canEditTeam(session, id)) return Astro.redirect('/portal/teams/');

// Club admins, and anyone who is a Manager on this team, can add people to it,
// change their roles and take them off. Approving logins stays with admins, so
// someone added here can't see or change anything until an admin approves them.
const leadsTeam = session.myTeams.some((t) => t.id === id && t.role_title === 'Manager');
const canManageCoaches = session.isAdmin || leadsTeam;

/** When a team's Manager (not an admin) changes its coaches, let the club inbox know. */
async function tellClub(teamName: string, what: string) {
  if (session.isAdmin) return;
  await sendEmail({
    to: [siteConfig.clubContactEmail],
    subject: `[Fusion FC] ${teamName}: coaches changed by ${session.fullName || session.email}`,
    replyTo: session.email,
    text: [
      `${session.fullName || session.email} (Manager of ${teamName}) ${what}.`,
      '',
      'New people need a club admin to approve their login (and give them one, if they need it) before they can use the team hub.',
      '',
      toAbsoluteUrl(`/portal/teams/${id}/`)
    ].join('\n')
  });
}

const created = Astro.url.searchParams.get('created');
let notice: { ok: boolean; text: string } | null = created === 'fulltime'
  ? { ok: true, text: 'Team added from Full-Time and linked to its fixtures. It is hidden for now: check the name, add its coaches, then tick "Show this team on the website".' }
  : created
  ? { ok: true, text: 'Created. Now add its coaches below; they can fill in the rest.' }
  : Astro.url.searchParams.get('sponsor')
  ? { ok: true, text: `Sponsor ${({ added: 'added', saved: 'saved', removed: 'removed' } as Record<string, string>)[Astro.url.searchParams.get('sponsor')!] ?? 'saved'}. The team page is updated.` }
  : Astro.url.searchParams.get('saved')
    ? { ok: true, text: 'Saved. The team page is updated.' }
    : null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'save');

  if (intent === 'save') {
    const managed = parseManagerTeamFields(form);
    const admin = session.isAdmin ? parseAdminTeamFields(form) : { values: {} };
    if (!managed.values) notice = { ok: false, text: managed.error ?? 'Please check the form.' };
    else if (!admin.values) notice = { ok: false, text: (admin as { error?: string }).error ?? 'Please check the form.' };
    else {
      const photo = await uploadTeamPhoto(supabase, id, form.get('photo'));
      if (photo.error) {
        notice = { ok: false, text: photo.error };
      } else {
        const values: Record<string, unknown> = { ...managed.values, ...admin.values };
        if (photo.url) values.photo_url = photo.url;
        else if (checked(form, 'remove_photo')) values.photo_url = null;
        const { error } = await supabase.from('teams').update(values).eq('id', id);
        const contactResult = error ? null : await saveTeamContact(supabase, id, managed.contact);
        if (error || contactResult?.error) {
          notice = { ok: false, text: (error ?? contactResult?.error)!.message };
        } else {
          return Astro.redirect(`/portal/teams/${id}/?saved=1`);
        }
      }
    }
  } else if (intent === 'sponsor-add' || intent === 'sponsor-save') {
    // Admins and this team's managers (checked above, and again by RLS).
    const sponsorId = String(form.get('sponsor_id') ?? '');
    const parsed = parseSponsorForm(form);
    const existing = intent === 'sponsor-save' && UUID.test(sponsorId)
      ? ((await supabase.from('team_sponsors').select('logo_url').eq('id', sponsorId).eq('team_id', id).maybeSingle()).data as Pick<TeamSponsor, 'logo_url'> | null)
      : null;
    if (parsed.error !== undefined) {
      notice = { ok: false, text: parsed.error };
    } else if (intent === 'sponsor-save' && !existing) {
      notice = { ok: false, text: 'That sponsor could not be found.' };
    } else {
      const logo = await uploadSponsorLogo(supabase, id, form.get('sponsor_logo'));
      if (logo.error) {
        notice = { ok: false, text: logo.error };
      } else {
        const values: Record<string, unknown> = { ...parsed.values };
        if (logo.url) values.logo_url = logo.url;
        else if (checked(form, 'remove_logo')) values.logo_url = null;
        const { error } = existing
          ? await supabase.from('team_sponsors').update(values).eq('id', sponsorId).eq('team_id', id)
          : await supabase.from('team_sponsors').insert({ ...values, team_id: id });
        if (error) {
          if (logo.url) await removeSponsorLogo(supabase, logo.url);
          notice = { ok: false, text: /team_sponsors/.test(error.message) ? 'Sponsors need migration 008_team_sponsors.sql to be run in Supabase.' : error.message };
        } else {
          if (existing && 'logo_url' in values) await removeSponsorLogo(supabase, existing.logo_url);
          return Astro.redirect(`/portal/teams/${id}/?sponsor=${existing ? 'saved' : 'added'}#sponsors`);
        }
      }
    }
  } else if (intent === 'sponsor-delete') {
    const sponsorId = String(form.get('sponsor_id') ?? '');
    if (UUID.test(sponsorId)) {
      const { data } = await supabase.from('team_sponsors').delete().eq('id', sponsorId).eq('team_id', id).select('logo_url');
      for (const row of (data ?? []) as Pick<TeamSponsor, 'logo_url'>[]) await removeSponsorLogo(supabase, row.logo_url);
    }
    return Astro.redirect(`/portal/teams/${id}/?sponsor=removed#sponsors`);
  } else if (canManageCoaches && ['add-manager', 'remove-manager', 'role-manager'].includes(intent)) {
    // Admins use their own login (RLS). A team's Managers go through the
    // server's key, only for this team, after the check above.
    const db = session.isAdmin ? supabase : adminSupabase();
    const teamName = ((await supabase.from('teams').select('name').eq('id', id).maybeSingle()).data as { name: string } | null)?.name ?? 'a team';
    const role = line(form, 'role_title', 40);
    const role_title = role && TEAM_ROLES.includes(role) ? role : 'Coach';
    if (!db) {
      notice = { ok: false, text: 'This needs SUPABASE_SERVICE_ROLE_KEY to be set on the server.' };
    } else if (intent === 'add-manager') {
      // Someone already in People, or a new person by name.
      let personId = String(form.get('person_id') ?? '');
      const newName = line(form, 'new_name', 80);
      if (personId === 'new') {
        if (!newName) personId = '';
        else {
          const { data: created, error: createError } = await db.from('people').insert({ full_name: newName }).select('id').single();
          personId = createError ? '' : created.id;
        }
      }
      if (!UUID.test(personId)) {
        notice = { ok: false, text: personId === '' && String(form.get('person_id')) === 'new' ? 'Enter their name.' : 'Choose someone to add.' };
      } else {
        const { data: added, error } = await db
          .from('team_managers')
          .insert({ team_id: id, person_id: personId, display_name: '', role_title, receives_enquiries: checked(form, 'receives_enquiries') })
          .select('display_name')
          .single();
        if (error) {
          notice = { ok: false, text: error.code === '23505' ? "They're already on this team." : error.message };
        } else {
          notice = { ok: true, text: 'Added to the team.' };
          await tellClub(teamName, `added ${added.display_name} as ${role_title}`);
        }
      }
    } else {
      const managerId = String(form.get('manager_id') ?? '');
      const { data: row } = UUID.test(managerId)
        ? await db.from('team_managers').select('id, user_id, display_name, role_title').eq('id', managerId).eq('team_id', id).maybeSingle()
        : { data: null };
      const target = row as { id: string; user_id: string | null; display_name: string; role_title: string } | null;
      if (!target) {
        notice = { ok: false, text: "They're not on this team." };
      } else if (!session.isAdmin && target.user_id === session.userId) {
        // Stops a manager locking themselves out; an admin can change it.
        notice = { ok: false, text: "You can't change your own place on the team. Ask a club admin." };
      } else if (intent === 'remove-manager') {
        const { error } = await db.from('team_managers').delete().eq('id', target.id).eq('team_id', id);
        notice = error ? { ok: false, text: error.message } : { ok: true, text: 'Taken off the team.' };
        if (!error) await tellClub(teamName, `took ${target.display_name} off the team (was ${target.role_title})`);
      } else if (role_title !== target.role_title) {
        const { error } = await db.from('team_managers').update({ role_title }).eq('id', target.id).eq('team_id', id);
        notice = error ? { ok: false, text: error.message } : { ok: true, text: `${target.display_name} is now ${role_title}.` };
        if (!error) await tellClub(teamName, `changed ${target.display_name} from ${target.role_title} to ${role_title}`);
      }
    }
  } else if (session.isAdmin && intent === 'delete') {
    await supabase.from('teams').delete().eq('id', id);
    return Astro.redirect('/portal/teams/');
  }
}

const [{ data: teamData }, { data: contactData }, { data: managerData }, { data: vacancyData }] = await Promise.all([
  supabase.from('teams').select('*').eq('id', id).maybeSingle(),
  supabase.from('team_contacts').select('whatsapp_number, email').eq('team_id', id).maybeSingle(),
  supabase
    .from('team_managers')
    .select('id, person_id, display_name, role_title, receives_enquiries, people(*)')
    .eq('team_id', id)
    .order('sort_order'),
  supabase.from('vacancies').select('*').eq('team_id', id).order('created_at', { ascending: false })
]);
const team = teamData as TeamRow | null;
if (!team) return Astro.redirect('/portal/teams/');
const contact = contactData as { whatsapp_number: string | null; email: string | null } | null;
const managers = (managerData ?? []) as unknown as {
  id: string; person_id: string | null; display_name: string; role_title: string; receives_enquiries: boolean;
  people: { email: string | null; user_id: string | null; photo_url?: string | null; show_on_site?: boolean } | null;
}[];
const vacancies = (vacancyData ?? []) as unknown as VacancyRow[];
const today = new Date().toISOString().slice(0, 10);
const isLive = (v: VacancyRow) => v.status === 'open' && v.published && (!v.expires_on || v.expires_on >= today);

const onTeam = new Set(managers.map((m) => m.person_id));
// Admins see emails to tell people apart; Managers see names only.
type Pickable = { id: string; full_name: string; email: string | null; user_id: string | null; profiles: { approved?: boolean } | null };
const peopleDb = session.isAdmin ? supabase : canManageCoaches ? adminSupabase() : null;
const people = peopleDb
  ? (((await peopleDb.from('people').select('id, full_name, email, user_id, profiles(approved)').order('full_name')).data ?? []) as unknown as Pickable[])
      .filter((p) => !onTeam.has(p.id))
      .map((p) => ({
        id: p.id,
        label: [
          p.full_name,
          session.isAdmin && p.email ? `(${p.email})` : null,
          p.user_id && p.profiles?.approved === false ? '· waiting for approval' : null
        ].filter(Boolean).join(' ')
      }))
  : [];
const [newEnquiries, { sponsors, ready: sponsorsReady }] = await Promise.all([countNewEnquiries(supabase), loadSponsorsForPortal(supabase, id)]);
---

<PortalLayout title={team.name} session={session} active="teams" activeTeam={team.id} newEnquiries={newEnquiries}>
  <div class="p-head">
    <div>
      {session.isAdmin && <a class="back" href="/portal/teams/">← Teams & sessions</a>}
      <h1>{team.name}</h1>
      <p class="p-sub" style="display:flex;gap:0.4rem;flex-wrap:wrap;align-items:center">
        <span class="pill grey">{team.age_group}</span>
        {team.kind === 'development' && <span class="pill grey">Development sessions</span>}
        {team.match_day && <span class="pill grey">{team.match_day}</span>}
        {team.league && <span>{team.league}</span>}
        {!team.published && <span class="pill warn">Hidden</span>}
      </p>
    </div>
    <div class="actions">
      {team.published && team.kind !== 'development' && <a class="btn outline" href={`/teams/${team.slug}/`} target="_blank" rel="noopener">View team page ↗</a>}
      {team.kind === 'development' && <a class="btn outline" href="/development-sessions/" target="_blank" rel="noopener">View sessions page ↗</a>}
      <a class="btn" href={`/portal/vacancies/new/?team=${team.id}`}>+ Vacancy</a>
    </div>
  </div>
  {notice && <div class:list={['msg', notice.ok ? 'ok' : 'bad']} role="status">{notice.text}</div>}

  <div class="card">
    <h2>Looking for players</h2>
    {vacancies.length === 0 && <p class="empty">No vacancies yet. Add one when the team has a space and it appears on the team page and the vacancies page.</p>}
    {vacancies.map((v) => (
      <div class="row">
        <div class="grow">
          <h3>{v.headline ?? positionsLabel(v)}</h3>
          <p>{positionsLabel(v)}{v.kind === 'player' && v.spaces > 1 ? ` · ${v.spaces} places` : ''}{v.whatsapp_enabled ? ` · ${v.whatsapp_clicks} WhatsApp taps` : ''}</p>
        </div>
        <div class="actions">
          {isLive(v) ? <span class="pill">Live</span> : <span class="pill grey">{v.status === 'filled' ? 'Filled' : 'Not live'}</span>}
          <a class="btn outline sm" href={`/portal/vacancies/${v.id}/`}>Edit</a>
        </div>
      </div>
    ))}
    <div style="margin-top:0.8rem"><a class="btn outline" href={`/portal/vacancies/new/?team=${team.id}`}>+ Add a vacancy</a></div>
  </div>

  <div class="card">
    <h2>{team.kind === 'development' ? 'Details' : 'Team page'}</h2>
    <form method="post" class="f" enctype="multipart/form-data">
      <input type="hidden" name="intent" value="save" />
      <TeamFields team={team} admin={session.isAdmin} contact={contact} />
      <div><button class="btn" type="submit">Save team</button></div>
    </form>
  </div>

  {team.kind !== 'development' && (
    <div class="card" id="sponsors">
      <h2>Sponsors</h2>
      <p class="p-sub" style="margin-bottom:0.6rem">Businesses that sponsor this team. They're shown, with their logo and a link to their website, on the team page.</p>
      {!sponsorsReady ? (
        <p class="empty">Sponsors need migration <code>008_team_sponsors.sql</code> to be run in Supabase. Ask a club admin.</p>
      ) : (
        <>
          {sponsors.length === 0 && <p class="empty">No sponsors yet.</p>}
          {sponsors.map((sp) => (
            <div class="row sponsor-row">
              <span class="logo" aria-hidden="true">{sp.logo_url ? <img src={sp.logo_url} alt="" loading="lazy" /> : sp.name.slice(0, 1).toUpperCase()}</span>
              <div class="grow">
                <h3>{sp.name}</h3>
                <p>{[sp.website && websiteLabel(sp.website), sp.blurb].filter(Boolean).join(' · ') || 'No website or description'}</p>
              </div>
              <details class="sponsor-edit">
                <summary class="btn outline sm">Edit</summary>
                <form method="post" class="f" enctype="multipart/form-data">
                  <input type="hidden" name="intent" value="sponsor-save" />
                  <input type="hidden" name="sponsor_id" value={sp.id} />
                  <SponsorFields sponsor={sp} />
                  <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
                    <button class="btn" type="submit">Save sponsor</button>
                  </div>
                </form>
                <form method="post" onsubmit="return confirm('Remove this sponsor from the team page?')" style="margin-top:0.5rem">
                  <input type="hidden" name="intent" value="sponsor-delete" />
                  <input type="hidden" name="sponsor_id" value={sp.id} />
                  <button class="btn danger sm" type="submit">Remove sponsor</button>
                </form>
              </details>
            </div>
          ))}
          <details class="sponsor-add" open={sponsors.length === 0 ? true : undefined}>
            <summary class="btn outline">+ Add a sponsor</summary>
            <form method="post" class="f" enctype="multipart/form-data" style="margin-top:0.8rem">
              <input type="hidden" name="intent" value="sponsor-add" />
              <SponsorFields />
              <div><button class="btn" type="submit">Add sponsor</button></div>
            </form>
          </details>
        </>
      )}
    </div>
  )}

  <div class="card">
    <h2>Coaches</h2>
    <p class="p-sub" style="margin-bottom:0.6rem">Coaches with a login can edit this team's page, post its vacancies and read its enquiries.{leadsTeam && !session.isAdmin ? " As this team's Manager, you can add people, change their roles and take them off." : ''}</p>
    {managers.length === 0 && <p class="empty">Nobody on this team yet.</p>}
    {managers.map((m) => (
      <div class="row coach-row">
        <span class="face" aria-hidden="true">{m.people?.photo_url ? <img src={m.people.photo_url} alt="" loading="lazy" /> : m.display_name.split(/\s+/).slice(0, 2).map((w) => w[0]?.toUpperCase()).join('')}</span>
        <div class="grow">
          <h3>
            {session.isAdmin && m.person_id ? <a href={`/portal/people/${m.person_id}/`}>{m.display_name}</a> : m.display_name}
            <span class="pill grey">{m.role_title}</span>
          </h3>
          <p>{[m.people?.email, m.people?.user_id ? 'has a login' : 'no login', m.receives_enquiries && m.people?.email ? 'gets enquiries' : null, m.people?.show_on_site ? 'on the team page' : null].filter(Boolean).join(' · ')}</p>
        </div>
        {canManageCoaches && (session.isAdmin || m.people?.user_id !== session.userId) && (
          <div class="coach-actions">
            <form method="post" class="role-form">
              <input type="hidden" name="intent" value="role-manager" />
              <input type="hidden" name="manager_id" value={m.id} />
              <select name="role_title" aria-label={`Role for ${m.display_name}`} onchange="this.form.requestSubmit()">
                {[...new Set([...TEAM_ROLES, m.role_title])].map((r) => <option value={r} selected={r === m.role_title}>{r}</option>)}
              </select>
              <noscript><button class="btn outline sm" type="submit">Save</button></noscript>
            </form>
            <form method="post" onsubmit={`return confirm('Take ${m.display_name.replace(/'/g, '')} off this team?')`}>
              <input type="hidden" name="intent" value="remove-manager" />
              <input type="hidden" name="manager_id" value={m.id} />
              <button class="btn danger sm" type="submit">Take off team</button>
            </form>
          </div>
        )}
      </div>
    ))}
    {canManageCoaches && (
      <form method="post" class="f" style="margin-top:1rem" data-add-coach>
        <input type="hidden" name="intent" value="add-manager" />
        <div class="two">
          <label>
            Add someone
            <select name="person_id" required>
              <option value="" disabled selected>Choose a person…</option>
              {people.map((p) => <option value={p.id}>{p.label}</option>)}
              <option value="new">Someone new…</option>
            </select>
          </label>
          <label>
            Role
            <select name="role_title">
              {TEAM_ROLES.map((r) => <option value={r} selected={r === 'Coach'}>{r}</option>)}
            </select>
          </label>
        </div>
        <label data-new-name hidden>Their name<input type="text" name="new_name" maxlength="80" /></label>
        <label class="check"><input type="checkbox" name="receives_enquiries" checked />Send them this team's enquiries by email</label>
        {session.isAdmin ? (
          <p class="hint">To add their email, mobile or a login, open them in <a href="/portal/people/">People</a>.</p>
        ) : (
          <p class="hint">
            A club admin is told about every change. Someone new can't use the team hub until a club admin approves them and, if they need one, gives
            them a login. If they haven't already, they can create one at <a href="/signup/">/signup/</a>.
          </p>
        )}
        <div><button class="btn outline" type="submit">Add to team</button></div>
      </form>
    )}
  </div>

  {session.isAdmin && (
    <div class="card">
      <h2>Delete team</h2>
      <p class="p-sub">Removes the team, its page and its vacancies. Enquiries are kept. To hide it for a while instead, untick "Show this team on the website".</p>
      <form method="post" onsubmit="return confirm('Delete this team, its page and its vacancies?')" style="margin-top:0.8rem">
        <input type="hidden" name="intent" value="delete" />
        <button class="btn danger" type="submit">Delete team</button>
      </form>
    </div>
  )}
</PortalLayout>

<ResizeUploads />

<script>
  // "Someone new…" asks for their name.
  const addCoach = document.querySelector<HTMLFormElement>('[data-add-coach]');
  if (addCoach) {
    const pick = addCoach.querySelector<HTMLSelectElement>('select[name="person_id"]')!;
    const nameField = addCoach.querySelector<HTMLElement>('[data-new-name]')!;
    const nameInput = nameField.querySelector('input')!;
    pick.addEventListener('change', () => {
      nameField.hidden = pick.value !== 'new';
      nameInput.required = pick.value === 'new';
      if (pick.value === 'new') nameInput.focus();
    });
  }

</script>

<style>
  .coach-actions { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
  .role-form select { min-height: 34px; padding: 0.25rem 0.5rem; font-size: 0.88rem; }
  .sponsor-row { align-items: flex-start; }
  .sponsor-row .logo {
    flex: none; width: 56px; height: 56px; border-radius: 10px; overflow: hidden; display: grid; place-items: center;
    background: #fff; border: 1px solid var(--line); color: #333; font-weight: 700;
  }
  .sponsor-row .logo img { width: 100%; height: 100%; object-fit: contain; padding: 4px; }
  .sponsor-edit { flex-basis: 100%; }
  .sponsor-edit[open] { padding: 0.8rem; border-radius: var(--radius-s); background: var(--surface-2); border: 1px solid var(--line); }
  .sponsor-edit summary, .sponsor-add summary { list-style: none; display: inline-flex; width: auto; }
  .sponsor-edit summary::-webkit-details-marker, .sponsor-add summary::-webkit-details-marker { display: none; }
  .sponsor-edit[open] summary { margin-bottom: 0.8rem; }
  .sponsor-add { margin-top: 0.8rem; }
  @media (min-width: 640px) { .sponsor-edit:not([open]) { flex-basis: auto; } }
</style>
