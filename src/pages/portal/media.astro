---
import PortalLayout from '../../components/portal/PortalLayout.astro';
import ResizeUploads from '../../components/portal/ResizeUploads.astro';
import { ago, countNewEnquiries } from '../../lib/portal';
import { MEDIA_BUCKET, fileSize, listMedia, mediaUsage, uploadMedia } from '../../lib/portal-media';

export const prerender = false;
const session = Astro.locals.session!;
const supabase = Astro.locals.supabase!;
if (!session.isAdmin) return Astro.redirect('/portal/');

let notice: { ok: boolean; text: string } | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('intent') === 'delete') {
    const path = String(form.get('path') ?? '');
    if (/^(images|documents)\/[\w.-]+$/.test(path)) {
      const { error } = await supabase.storage.from(MEDIA_BUCKET).remove([path]);
      notice = error ? { ok: false, text: error.message } : { ok: true, text: 'File deleted.' };
    }
  } else {
    const files = form.getAll('files');
    let done = 0;
    for (const file of files) {
      const isPdf = file instanceof File && file.type === 'application/pdf';
      const result = await uploadMedia(supabase, file, isPdf ? 'documents' : 'images');
      if (result.error) {
        notice = { ok: false, text: `${file instanceof File ? file.name : 'File'}: ${result.error}` };
        break;
      }
      if (result.url) done++;
    }
    if (!notice) notice = done ? { ok: true, text: `${done} ${done === 1 ? 'file' : 'files'} uploaded.` } : { ok: false, text: 'Choose a file to upload.' };
  }
}

const [images, documents, newEnquiries] = await Promise.all([listMedia(supabase, 'images'), listMedia(supabase, 'documents'), countNewEnquiries(supabase)]);
const usage = await mediaUsage(supabase, [...images.items, ...documents.items].map((i) => i.url));
const bucketMissing = images.error && /not found/i.test(images.error);
const nice = (n: string) => n.replace(/\.\w+$/, '').replace(/[-_]+/g, ' ');
const unused = [...images.items, ...documents.items].filter((i) => !usage.get(i.url)?.length).length;
---

<PortalLayout title="Photos & files" session={session} active="media" newEnquiries={newEnquiries}>
  <div class="p-head">
    <div>
      <h1>Photos &amp; files</h1>
      <p class="p-sub">Photos and PDFs for pages and blog posts. Upload them here, then add them with the "Photo or PDF" button when editing.</p>
    </div>
  </div>
  {notice && <div class:list={['msg', notice.ok ? 'ok' : 'bad']} role="status">{notice.text}</div>}
  {bucketMissing && <div class="msg bad">Photos &amp; files needs migration <code>004_site_content.sql</code> to be run in Supabase (see the README).</div>}

  <form method="post" enctype="multipart/form-data" class="drop" data-drop>
    <input id="files" type="file" name="files" multiple accept="image/jpeg,image/png,image/webp,image/gif,application/pdf" data-resize="2000" />
    <label for="files">
      <strong>Drop photos or PDFs here</strong>
      <span>or click to choose. Photos are shrunk automatically; PDFs up to 4MB.</span>
    </label>
    <div class="drop-chosen" data-chosen hidden>
      <span data-chosen-text></span>
      <button class="btn" type="submit">Upload</button>
    </div>
  </form>

  <div class="toolbar">
    <nav class="tabs" aria-label="Filter files">
      <button type="button" data-filter="all" aria-pressed="true">All<span class="n">{images.items.length + documents.items.length}</span></button>
      <button type="button" data-filter="photo" aria-pressed="false">Photos<span class="n">{images.items.length}</span></button>
      <button type="button" data-filter="pdf" aria-pressed="false">PDFs<span class="n">{documents.items.length}</span></button>
      {unused > 0 && <button type="button" data-filter="unused" aria-pressed="false">Not used<span class="n">{unused}</span></button>}
    </nav>
    <input class="search" type="search" placeholder="Search files" aria-label="Search files" data-search />
  </div>

  {images.items.length === 0 && documents.items.length === 0 && <div class="card"><p class="empty">Nothing uploaded yet.</p></div>}

  <div class="media-grid">
    {[...images.items, ...documents.items].map((item) => {
      const used = usage.get(item.url) ?? [];
      return (
        <figure class="media" data-item data-kind={item.isPdf ? 'pdf' : 'photo'} data-used={String(used.length > 0)} data-text={`${item.name} ${used.join(' ')}`.toLowerCase()}>
          <a class="media-thumb" href={item.url} target="_blank" rel="noopener">
            {item.isPdf ? <span class="pdf">PDF</span> : <img src={item.url} alt="" loading="lazy" />}
          </a>
          <figcaption>
            <span class="media-name" title={item.name}>{item.name}</span>
            <span class="media-meta">{[fileSize(item.size), item.created && `added ${ago(item.created)}`].filter(Boolean).join(' · ')}</span>
            <span class:list={['media-used', used.length === 0 && 'none']} title={used.join('\n')}>
              {used.length ? `Used on ${used.length === 1 ? used[0] : `${used.length} pages`}` : 'Not used yet'}
            </span>
            <span class="media-actions">
              <button type="button" class="btn outline sm" data-copy={item.isPdf ? `[${nice(item.name)}](${item.url})` : `![${nice(item.name)}](${item.url})`}>Copy for page</button>
              <button type="button" class="btn outline sm" data-copy={item.url}>Copy link</button>
              <form method="post" data-confirm={used.length ? `This is used on: ${used.join(', ')}. Deleting it will leave a broken ${item.isPdf ? 'link' : 'image'} there. Delete anyway?` : 'Delete this file?'}>
                <input type="hidden" name="intent" value="delete" />
                <input type="hidden" name="path" value={item.path} />
                <button class="btn danger sm" type="submit">Delete</button>
              </form>
            </span>
          </figcaption>
        </figure>
      );
    })}
  </div>
  <p class="empty" data-none hidden>No files match.</p>
</PortalLayout>

<ResizeUploads />

<script>
  // Copy buttons.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const label = button.textContent;
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'Copied!';
      } catch {
        button.textContent = 'Copy failed';
      }
      setTimeout(() => (button.textContent = label), 1600);
    });
  });
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) =>
    form.addEventListener('submit', (e) => {
      if (!confirm(form.dataset.confirm!)) e.preventDefault();
    })
  );

  // Drop zone: dropped or chosen files show a count and an Upload button.
  const drop = document.querySelector<HTMLFormElement>('[data-drop]')!;
  const input = drop.querySelector<HTMLInputElement>('input[type="file"]')!;
  const chosen = drop.querySelector<HTMLElement>('[data-chosen]')!;
  const showChosen = () => {
    const n = input.files?.length ?? 0;
    chosen.hidden = n === 0;
    drop.querySelector('[data-chosen-text]')!.textContent = n === 1 ? input.files![0]!.name : `${n} files chosen`;
  };
  input.addEventListener('change', showChosen);
  ['dragenter', 'dragover'].forEach((t) => drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((t) => drop.addEventListener(t, () => drop.classList.remove('over')));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    if (!e.dataTransfer?.files.length) return;
    input.files = e.dataTransfer.files;
    input.dispatchEvent(new Event('change', { bubbles: true })); // resizes photos, then shows the count
  });

  // Filters and search.
  const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
  const search = document.querySelector<HTMLInputElement>('[data-search]')!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  let filter = 'all';
  const apply = () => {
    const q = search.value.trim().toLowerCase();
    items.forEach((el) => {
      const ok = filter === 'all' || el.dataset.kind === filter || (filter === 'unused' && el.dataset.used === 'false');
      el.hidden = !ok || (Boolean(q) && !(el.dataset.text ?? '').includes(q));
    });
    document.querySelector<HTMLElement>('[data-none]')!.hidden = items.length === 0 || items.some((el) => !el.hidden);
  };
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      filter = b.dataset.filter!;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    })
  );
  search.addEventListener('input', apply);
</script>

<style>
  .drop {
    position: relative; display: grid; gap: 0.8rem; justify-items: center; text-align: center; margin-bottom: 1.2rem;
    padding: 1.6rem 1rem; border: 1.5px dashed var(--line-strong); border-radius: var(--radius-m); background: var(--surface);
  }
  .drop.over, .drop:hover { border-color: var(--accent); background: var(--accent-soft); }
  .drop input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .drop label { display: grid; gap: 0.25rem; cursor: pointer; }
  .drop label strong { font-family: var(--font-display); font-size: 1.05rem; }
  .drop label span { font-size: 0.85rem; color: var(--text-3); }
  .drop input:focus-visible + label { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 6px; }
  .drop-chosen { display: flex; gap: 0.8rem; align-items: center; flex-wrap: wrap; justify-content: center; font-size: 0.9rem; }
  .drop-chosen[hidden] { display: none; }

  .media-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 0.9rem; }
  .media { margin: 0; border: 1px solid var(--line); border-radius: var(--radius-m); overflow: hidden; background: var(--surface); }
  .media[hidden] { display: none; }
  .media-thumb { display: block; background: var(--surface-2); }
  .media img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  .media .pdf { display: grid; place-items: center; aspect-ratio: 4 / 3; font-family: var(--font-display); font-weight: 700; font-size: 1.4rem; color: #f5a3a3; }
  .media figcaption { display: grid; gap: 0.3rem; padding: 0.75rem; }
  .media-name { font-size: 0.86rem; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .media-meta { font-size: 0.75rem; color: var(--text-3); }
  .media-used { font-size: 0.78rem; color: var(--accent); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .media-used.none { color: var(--text-3); }
  .media-actions { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.35rem; }
</style>
