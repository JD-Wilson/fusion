---
import PortalLayout from '../../../components/portal/PortalLayout.astro';
import MarkdownField from '../../../components/portal/MarkdownField.astro';
import ResizeUploads from '../../../components/portal/ResizeUploads.astro';
import { clearContentCache } from '../../../lib/content';
import { checked, line, text } from '../../../lib/forms';
import { ago, countNewEnquiries } from '../../../lib/portal';
import { listMedia, uploadMedia } from '../../../lib/portal-media';
import { CORE_PAGE_NAMES, loadEditablePage, publicPath, type EditablePage } from '../../../lib/portal-pages';

export const prerender = false;
const session = Astro.locals.session!;
const supabase = Astro.locals.supabase!;
if (!session.isAdmin) return Astro.redirect('/portal/');

const slug = Astro.params.slug ?? '';
const loaded = /^[a-z0-9][a-z0-9-]{0,59}$/.test(slug) ? await loadEditablePage(supabase, slug) : null;
if (!loaded) return Astro.redirect('/portal/pages/');
let page: EditablePage = loaded;

let notice: { ok: boolean; text: string } | null = Astro.url.searchParams.get('created')
  ? { ok: true, text: 'Page created. Add its content, then tick "Show on the website" and save.' }
  : Astro.url.searchParams.get('saved')
    ? { ok: true, text: 'Saved. The website updates within a couple of minutes.' }
    : null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'save');

  if (intent === 'restore' && page.core && page.inDatabase) {
    // Back to the wording in the original markdown file.
    await supabase.from('site_pages').delete().eq('slug', slug);
    clearContentCache();
    return Astro.redirect('/portal/pages/?saved=restored');
  }

  if (intent === 'delete' && !page.core) {
    if (page.hasFile) {
      // Pages that came with the site can't be removed from the code here: hide them instead.
      await supabase.from('site_pages').upsert({ ...stripMeta(page), published: false, updated_by: session.userId });
    } else {
      await supabase.from('site_pages').delete().eq('slug', slug);
    }
    clearContentCache();
    return Astro.redirect('/portal/pages/?saved=deleted');
  }

  // Values from the form (kept on screen if saving fails).
  page = {
    ...page,
    title: line(form, 'title', 120) ?? '',
    description: text(form, 'description', 400) ?? '',
    body: String(form.get('body') ?? '').slice(0, 60000),
    nav_label: page.core ? page.nav_label : line(form, 'nav_label', 40),
    show_in_nav: page.core ? page.show_in_nav : checked(form, 'show_in_nav'),
    sort_order: page.core ? page.sort_order : Number(text(form, 'sort_order', 4)) || 100,
    attachment_label: page.core ? page.attachment_label : line(form, 'attachment_label', 60),
    seo_title: line(form, 'seo_title', 90),
    seo_description: line(form, 'seo_description', 180),
    noindex: checked(form, 'noindex'),
    published: page.core ? true : checked(form, 'published')
  };

  if (!page.title) {
    notice = { ok: false, text: 'The page needs a title.' };
  } else {
    const hero = await uploadMedia(supabase, form.get('hero_file'), 'images', { imagesOnly: true });
    const pdf = page.core ? { url: null } : await uploadMedia(supabase, form.get('attachment_file'), 'documents', { pdfOnly: true });
    const uploadError = hero.error ?? (pdf as { error?: string }).error;
    if (uploadError) {
      notice = { ok: false, text: uploadError };
    } else {
      if (hero.url) page.hero_image = hero.url;
      else if (checked(form, 'remove_hero')) page.hero_image = null;
      if (pdf.url) page.attachment_url = pdf.url;
      else if (checked(form, 'remove_attachment')) page.attachment_url = null;

      const { error } = await supabase.from('site_pages').upsert({ ...stripMeta(page), updated_by: session.userId });
      if (error) {
        notice = { ok: false, text: error.message };
      } else {
        clearContentCache();
        return Astro.redirect(`/portal/pages/${slug}/?saved=1`);
      }
    }
  }
}

function stripMeta(p: EditablePage) {
  const { inDatabase: _a, hasFile: _b, core: _c, updated_at: _d, ...row } = p;
  return row;
}

const name = CORE_PAGE_NAMES[slug] ?? page.title;
const [newEnquiries, images, documents] = await Promise.all([
  countNewEnquiries(supabase),
  listMedia(supabase, 'images'),
  listMedia(supabase, 'documents')
]);
const status = page.published ? 'Live' : 'Hidden';
---

<PortalLayout title={`Edit ${name}`} session={session} active="pages" newEnquiries={newEnquiries}>
  <div class="p-head">
    <div>
      <a class="back" href="/portal/pages/">← Pages</a>
      <h1>{name}</h1>
      <p class="p-sub">{publicPath(slug)}{!page.inDatabase && ' · showing the original wording until you save'}</p>
    </div>
  </div>
  {notice && <div class:list={['msg', notice.ok ? 'ok' : 'bad']} role="status">{notice.text}</div>}

  <form method="post" class="f editor" enctype="multipart/form-data" data-guard>
    <div class="editor-main">
      <div class="card stack">
        <label>Title<input class="title-input" type="text" name="title" required maxlength="120" value={page.title} /></label>
        <label>
          Introduction
          <textarea name="description" maxlength="400" rows="3">{page.description}</textarea>
          <span class="hint">Shown under the title at the top of the page, and in search results.</span>
        </label>
        <MarkdownField name="body" label="Main content" value={page.body} media={[...images.items, ...documents.items]} />
      </div>
    </div>

    <aside class="editor-side">
      <div class="card stack publish">
        <h2>{page.core ? 'Save' : 'Publish'}</h2>
        <dl>
          <dt>Status</dt><dd><span class:list={['pill', !page.published && 'warn']}>{status}</span></dd>
          <dt>Address</dt><dd>{publicPath(slug)}</dd>
          <dt>Edited</dt><dd>{page.inDatabase && page.updated_at ? ago(page.updated_at) : 'Not yet'}</dd>
        </dl>
        {!page.core && <label class="check"><input type="checkbox" name="published" checked={page.published} />Show on the website</label>}
        <div class="publish-actions">
          <button class="btn" type="submit" name="intent" value="save">Save</button>
          {page.published && <a class="btn outline" href={publicPath(slug)} target="_blank" rel="noopener">View ↗</a>}
        </div>
      </div>

      <div class="card stack">
        <h2>Top photo</h2>
        <div class="photo-row">
          {page.hero_image ? <img class="photo-preview" src={page.hero_image} alt="" /> : <div class="photo-preview empty">Using the page's default photo</div>}
          <div class="photo-fields">
            <label>
              Replace the photo
              <input type="file" name="hero_file" accept="image/jpeg,image/png,image/webp" data-resize />
              <span class="hint">A wide (landscape) photo works best.</span>
            </label>
            {page.hero_image && <label class="check"><input type="checkbox" name="remove_hero" />Go back to the default photo</label>}
          </div>
        </div>
      </div>

      {!page.core && (
        <div class="card stack">
          <h2>Menus and documents</h2>
          <label class="check"><input type="checkbox" name="show_in_nav" checked={page.show_in_nav} />Show in the Club menu and footer</label>
          <div class="two">
            <label>Menu label<input type="text" name="nav_label" maxlength="40" value={page.nav_label ?? ''} placeholder={page.title} /></label>
            <label>Menu order<input type="number" name="sort_order" min="1" max="999" value={String(page.sort_order)} /><span class="hint">Lower numbers come first.</span></label>
          </div>
          <label>
            PDF version (optional)
            <input type="file" name="attachment_file" accept="application/pdf" />
            <span class="hint">{page.attachment_url ? <>Current file: <a href={page.attachment_url} target="_blank" rel="noopener">open</a>. Choose a new one to replace it.</> : 'Adds a download button under the page, e.g. a signed copy of a policy. Up to 4MB.'}</span>
          </label>
          <label>Button label<input type="text" name="attachment_label" maxlength="60" value={page.attachment_label ?? ''} placeholder="Download PDF" /></label>
          {page.attachment_url && <label class="check"><input type="checkbox" name="remove_attachment" />Remove the PDF</label>}
        </div>
      )}

      <details class="card">
        <summary>Search engines (optional)</summary>
        <div class="stack" style="margin-top:0.9rem">
          <label>Search title<input type="text" name="seo_title" maxlength="90" value={page.seo_title ?? ''} placeholder={page.title} /></label>
          <label>Search description<input type="text" name="seo_description" maxlength="180" value={page.seo_description ?? ''} placeholder={page.description} /></label>
          <label class="check"><input type="checkbox" name="noindex" checked={page.noindex} />Hide this page from search engines</label>
        </div>
      </details>
    </aside>

    <div class="save-bar">
      <button class="btn" type="submit" name="intent" value="save">Save</button>
      <span class="dirty" data-dirty hidden>Unsaved changes</span>
    </div>
  </form>

  {page.core && page.inDatabase && (
    <div class="card danger-zone" style="margin-top:1.5rem">
      <h2>Restore original</h2>
      <p class="p-sub">Go back to the page's original wording and photo. Your changes will be lost.</p>
      <form method="post" onsubmit="return confirm('Restore the original wording? Your changes will be lost.')" style="margin-top:0.8rem">
        <button class="btn danger" type="submit" name="intent" value="restore">Restore original</button>
      </form>
    </div>
  )}

  {!page.core && (
    <div class="card danger-zone" style="margin-top:1.5rem">
      <h2>{page.hasFile ? 'Hide page' : 'Delete page'}</h2>
      <p class="p-sub">
        {page.hasFile
          ? 'This page came with the website, so it can be hidden but not deleted.'
          : 'Removes the page from the website for good.'}
      </p>
      <form method="post" onsubmit="return confirm('Are you sure?')" style="margin-top:0.8rem">
        <button class="btn danger" type="submit" name="intent" value="delete">{page.hasFile ? 'Hide page' : 'Delete page'}</button>
      </form>
    </div>
  )}
</PortalLayout>

<ResizeUploads />
