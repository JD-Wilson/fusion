---
import PortalLayout from '../../../components/portal/PortalLayout.astro';
import PersonFields from '../../../components/portal/PersonFields.astro';
import ProfileFields from '../../../components/portal/ProfileFields.astro';
import ResizeUploads from '../../../components/portal/ResizeUploads.astro';
import { countNewEnquiries, loadTeams, ukDate } from '../../../lib/portal';
import {
  accessOf,
  applyAccess,
  approveLogin,
  draftFromForm,
  isPending,
  loadPerson,
  parsePersonForm,
  saveAssignments,
  saveProfile,
  setTemporaryPassword,
  signedInUserIds,
  type Person
} from '../../../lib/portal-people';
import { adminSupabase } from '../../../lib/supabase';

export const prerender = false;
const session = Astro.locals.session!;
const supabase = Astro.locals.supabase!;
if (!session.isAdmin) return Astro.redirect('/portal/');

const loaded = await loadPerson(supabase, Astro.params.id ?? '');
if (!loaded) return Astro.redirect('/portal/people/');
const isSelf = loaded.user_id === session.userId;
let person: Partial<Person> = loaded;

const q = Astro.url.searchParams;
let notice: { ok: boolean; text: string } | null = q.get('problem')
  ? { ok: false, text: q.get('problem')! }
  : q.get('created') || q.get('saved')
    ? { ok: true, text: [q.get('created') ? 'Person added.' : 'Saved.', q.get('note')].filter(Boolean).join(' ') }
    : null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'save');

  if (intent === 'delete' && !isSelf) {
    // Their login goes too; their team places go with the person.
    if (loaded.user_id) await adminSupabase()?.auth.admin.deleteUser(loaded.user_id);
    await supabase.from('people').delete().eq('id', loaded.id);
    return Astro.redirect('/portal/people/?deleted=1');
  }

  if (intent === 'public_profile') {
    const error = await saveProfile(loaded.id, form, loaded);
    if (!error) return Astro.redirect(`/portal/people/${loaded.id}/?saved=1#profile`);
    notice = { ok: false, text: error };
  } else if (intent === 'approve' && !isSelf && loaded.user_id) {
    const error = await approveLogin(loaded.user_id);
    if (!error) return Astro.redirect(`/portal/people/${loaded.id}/?saved=1&note=${encodeURIComponent(`${loaded.full_name} is approved and can now use the team hub.`)}`);
    notice = { ok: false, text: error };
  } else if (intent === 'temp_password' && !isSelf && loaded.user_id) {
    const error = await setTemporaryPassword(loaded.user_id, String(form.get('temp_password') ?? '').slice(0, 72));
    notice = error
      ? { ok: false, text: error }
      : { ok: true, text: `Temporary password set. Send it to ${loaded.full_name.split(' ')[0]}; they'll choose their own when they next sign in.` };
  } else if (intent === 'save') {
    const parsed = parsePersonForm(form);
    if (parsed.error !== undefined) {
      notice = { ok: false, text: parsed.error };
      person = { ...loaded, ...draftFromForm(form), email: loaded.user_id ? loaded.email : String(form.get('email') ?? '') };
    } else {
      // A login's email belongs to the login.
      const values = { ...parsed.values, email: loaded.user_id ? loaded.email : parsed.values.email };
      const { error } = await supabase.from('people').update(values).eq('id', loaded.id);
      if (error) {
        notice = { ok: false, text: error.code === '23505' ? 'Someone else in People already has that email.' : error.message };
        person = { ...loaded, ...draftFromForm(form) };
      } else {
        const teamError = await saveAssignments(supabase, loaded.id, parsed.teams);
        const access = isSelf ? accessOf(loaded) : parsed.access;
        const login = access === accessOf(loaded) ? {} : await applyAccess({ ...loaded, ...values }, access, parsed.tempPassword);
        const params = new URLSearchParams({ saved: '1' });
        if (teamError) params.set('problem', teamError.message);
        else if (login.error) params.set('problem', `Saved, but the login wasn't changed: ${login.error}`);
        if (login.note) params.set('note', login.note);
        return Astro.redirect(`/portal/people/${loaded.id}/?${params}`);
      }
    }
  }
}

const [teams, signedIn, newEnquiries] = await Promise.all([loadTeams(supabase), signedInUserIds(), countNewEnquiries(supabase)]);
const access = accessOf(loaded);
const pending = isPending(loaded);
const invited = !pending && access !== 'none' && loaded.user_id && !signedIn.has(loaded.user_id);
---

<PortalLayout title={loaded.full_name} session={session} active="people" newEnquiries={newEnquiries}>
  <div class="p-head">
    <div>
      <a class="back" href="/portal/people/">← People</a>
      <h1>
        {loaded.full_name}
        {access === 'admin' && <span class="pill">Club admin</span>}
        {access === 'coach' && <span class="pill">Coach login</span>}
        {pending && <span class="pill warn">Waiting for approval</span>}
        {invited && <span class="pill grey">Hasn't signed in yet</span>}
      </h1>
      <p class="p-sub">{loaded.team_managers.length ? `On ${loaded.team_managers.length} ${loaded.team_managers.length === 1 ? 'team' : 'teams'}` : 'Not on a team yet'}</p>
    </div>
  </div>
  {notice && <div class:list={['msg', notice.ok ? 'ok' : 'bad']} role="status">{notice.text}</div>}

  {pending && !isSelf && (
    <div class="card approve">
      <h2>Signed up{loaded.profiles?.created_at ? ` on ${ukDate(loaded.profiles.created_at)}` : ''}, waiting for approval</h2>
      <p class="p-sub">
        Check this is really {loaded.full_name} ({loaded.email}) before approving. Until then they can sign in but can't see or change anything.
        Tick their teams below and save first, or approve now and add teams after.
      </p>
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:0.8rem">
        <form method="post"><input type="hidden" name="intent" value="approve" /><button class="btn" type="submit">Approve</button></form>
        <form method="post" onsubmit="return confirm('Reject this sign-up? Their login and People entry are removed.')">
          <input type="hidden" name="intent" value="delete" /><button class="btn danger" type="submit">Reject and remove</button>
        </form>
      </div>
    </div>
  )}

  <div class="card">
    <form method="post" class="f">
      <input type="hidden" name="intent" value="save" />
      <PersonFields person={person} teams={teams} self={isSelf} />
      <div><button class="btn" type="submit">Save</button></div>
    </form>
  </div>

  <div class="card" id="profile">
    <h2>Profile</h2>
    <p class="p-sub" style="margin-bottom:0.8rem">{loaded.user_id && !isSelf ? `${loaded.full_name.split(' ')[0]} can also do this themselves from My account. ` : ''}Only shown on team pages if the box at the bottom is ticked.</p>
    <form method="post" class="f" enctype="multipart/form-data">
      <input type="hidden" name="intent" value="public_profile" />
      <ProfileFields person={loaded} self={isSelf} />
      <div><button class="btn" type="submit">Save profile</button></div>
    </form>
  </div>

  {loaded.user_id && !isSelf && (
    <div class="card">
      <h2>Set a temporary password</h2>
      <p class="p-sub">If {loaded.full_name.split(' ')[0]} is locked out. Send them the password (e.g. on WhatsApp); they'll be asked to choose their own when they sign in.</p>
      <form method="post" class="f temp-pw" style="margin-top:0.8rem">
        <input type="hidden" name="intent" value="temp_password" />
        <label>Temporary password<input type="text" name="temp_password" minlength="8" maxlength="72" autocomplete="off" required data-temp /></label>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
          <button class="btn outline" type="button" data-generate>Make one up for me</button>
          <button class="btn" type="submit">Set password</button>
        </div>
      </form>
    </div>
  )}

  {!isSelf && (
    <div class="card">
      <h2>Remove {loaded.full_name}</h2>
      <p class="p-sub">Takes them off all their teams{loaded.user_id ? ' and removes their login' : ''}. Vacancies and enquiries are kept.</p>
      <form method="post" onsubmit="return confirm('Remove this person from the club?')" style="margin-top:0.8rem">
        <input type="hidden" name="intent" value="delete" />
        <button class="btn danger" type="submit">Remove person</button>
      </form>
    </div>
  )}
</PortalLayout>

<ResizeUploads />
