---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import TeamCard from '../../components/TeamCard.astro';
import { createBreadcrumbJsonLd } from '../../lib/seo';
import { getPublicTeams, getVacanciesByTeam } from '../../lib/teams';
import { ageNumber } from '../../lib/vacancies';

// Rendered per request so managers' edits show straight away.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=30, stale-while-revalidate=300');

const teams = await getPublicTeams();
const spaces = await getVacanciesByTeam();
const age = Astro.url.searchParams.get('age') ?? '';

const ages = teams ? [...new Set(teams.map((t) => t.age_group))].sort((a, b) => ageNumber(a) - ageNumber(b)) : [];
const shown = (teams ?? []).filter((t) => !age || t.age_group === age);
const groups = [
  { title: 'Saturday Teams', teams: shown.filter((t) => t.match_day === 'Saturday') },
  { title: 'Sunday Teams', teams: shown.filter((t) => t.match_day === 'Sunday') },
  { title: '', teams: shown.filter((t) => !t.match_day) }
].filter((g) => g.teams.length);
const recruiting = (teams ?? []).filter((t) => spaces.has(t.id)).length;

const breadcrumbs = createBreadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: 'Teams', path: '/teams/' }
]);
---

<BaseLayout
  title="Our Teams | Fusion FC"
  description="Every Fusion FC team in one place. Find your age group, see which teams are looking for players, and message the coach directly."
  canonical="/teams/"
  structuredData={[breadcrumbs]}
>
  <PageHero
    eyebrow="Fusion Football Club"
    title="Our teams"
    summary="Find your age group, see which teams are looking for players, and message the coach directly."
    image="/images/web/coach-directing.jpg"
    imagePosition="50% 35%"
    actions={recruiting > 0 ? [{ href: '/vacancies/', label: `${recruiting} ${recruiting === 1 ? 'team is' : 'teams are'} looking for players` }] : []}
  />

  {
    teams === null ? (
      <section class="section-card">
        <h2 class="section-title">Teams are coming soon</h2>
        <p class="section-copy">
          In the meantime, see our <a class="inline" href="/age-groups/">age groups</a> or <a class="inline" href="/join/">tell us about your player</a>.
        </p>
      </section>
    ) : (
      <>
        {ages.length > 1 && (
          <nav class="age-filter" aria-label="Filter by age group">
            <a class:list={['af', !age && 'on']} href="/teams/">All ages</a>
            {ages.map((a) => (
              <a class:list={['af', age === a && 'on']} href={`/teams/?age=${a}`}>{a}</a>
            ))}
          </nav>
        )}

        {groups.map((group) => (
          <section class="team-group">
            {group.title && (
              <div class="group-head">
                <h2>{group.title}</h2>
                <span>{group.teams.length}</span>
              </div>
            )}
            <div class="team-grid">
              {group.teams.map((team) => <TeamCard team={team} openSpaces={spaces.get(team.id)?.length ?? 0} />)}
            </div>
          </section>
        ))}
      </>
    )
  }
</BaseLayout>

<style>
  .inline {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .age-filter {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    margin-top: var(--space-xl);
    padding-bottom: 0.3rem;
    scrollbar-width: none;
  }

  .af {
    flex: none;
    display: inline-flex;
    align-items: center;
    height: 38px;
    padding: 0 1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text-2);
    font-size: 0.9rem;
    font-weight: 500;
    transition: border-color var(--transition), color var(--transition);
  }

  .af:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }

  .af.on {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .team-group {
    margin-top: var(--space-l);
  }

  .group-head {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-bottom: 1rem;
  }

  .group-head h2 {
    font-size: 1.4rem;
  }

  .group-head span {
    font-size: 0.85rem;
    color: var(--text-3);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 1rem;
  }
</style>
