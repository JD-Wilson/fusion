---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { createBlogPostingJsonLd, createBreadcrumbJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog', ({ data }) => !data.draft);

  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props as Props;
const { Content } = await render(entry);

// Estimated reading time
const wordCount = (entry.body ?? '').split(/\s+/).length;
const readingTime = Math.max(1, Math.round(wordCount / 200));

const breadcrumbs = createBreadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: entry.data.title, path: `/blog/${entry.id}/` }
]);

const articleSchema = createBlogPostingJsonLd({
  title: entry.data.title,
  description: entry.data.seoDescription ?? entry.data.excerpt,
  slug: entry.id,
  publishedTime: entry.data.date.toISOString(),
  modifiedTime: entry.data.updatedDate?.toISOString(),
  image: entry.data.ogImage ?? entry.data.coverImage
});

const formattedDate = entry.data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});

// Logos are shown whole on a white panel instead of stretched like a photo
const coverIsLogo = /\.png$/i.test(entry.data.coverImage) || entry.data.coverImage.includes('/partners/');
// Skip the cover if the post body already opens with the same image
const showCover = !(entry.body ?? '').includes(entry.data.coverImage);

// Up to two other posts to keep reading
const morePosts = (await getCollection('blog', ({ data }) => !data.draft && !data.noindex))
  .filter((post) => post.id !== entry.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);
---

<BaseLayout
  title={entry.data.seoTitle ?? entry.data.title}
  description={entry.data.seoDescription ?? entry.data.excerpt}
  canonical={entry.data.canonicalUrl ?? `/blog/${entry.id}/`}
  image={entry.data.ogImage ?? entry.data.coverImage}
  type="article"
  publishedTime={entry.data.date.toISOString()}
  modifiedTime={entry.data.updatedDate?.toISOString()}
  noindex={entry.data.noindex}
  structuredData={[breadcrumbs, articleSchema]}
>
  <!-- Reading progress bar -->
  <div class="reading-progress" aria-hidden="true">
    <div class="reading-bar" id="reading-bar"></div>
  </div>

  <article>
    <section class="page-hero article-hero reveal">
      <a class="eyebrow eyebrow-link" href="/blog/">Fusion Blog</a>
      <h1 class="hero-title">{entry.data.title}</h1>
      <p class="hero-summary">{entry.data.excerpt}</p>
      <div class="article-meta">
        <time class="meta-date" datetime={entry.data.date.toISOString()}>{formattedDate}</time>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span class="meta-author">{entry.data.author}</span>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span class="meta-read">{readingTime} min read</span>
      </div>
      {entry.data.tags.length > 0 && (
        <div class="chip-list article-hero-tags">
          {entry.data.tags.map((tag) => <span class="chip">{tag}</span>)}
        </div>
      )}
    </section>

    <section class:list={['article-band', !showCover && 'no-cover']} id="article-body">
      {showCover && (
        <figure class:list={['article-cover-wrap', coverIsLogo && 'is-logo']}>
          <img
            src={entry.data.coverImage}
            alt={entry.data.title}
            class="article-cover"
            fetchpriority="high"
          />
        </figure>
      )}

      <div class="prose article-prose">
        <Content />
      </div>

      <div class="article-footer">
        <div class="footer-row">
          <a class="back-link" href="/blog/">← Back to blog</a>
          <button class="copy-btn" id="copy-link" type="button" aria-label="Copy link to this post">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span class="copy-label">Copy link</span>
          </button>
        </div>
      </div>
    </section>
  </article>

  {morePosts.length > 0 && (
    <section class="dark-band more-posts" aria-labelledby="more-heading">
      <div class="band-head">
        <div>
          <p class="band-eyebrow">Latest Posts</p>
          <h2 class="band-title" id="more-heading">Club Updates</h2>
        </div>
        <a class="more-all" href="/blog/">Blog →</a>
      </div>
      <div class="more-grid">
        {morePosts.map((post) => <BlogCard post={post} />)}
      </div>
    </section>
  )}

  <!-- Scroll to top -->
  <button class="scroll-top" id="scroll-top" type="button" aria-label="Back to top">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg>
  </button>
</BaseLayout>

<style>
  /* ─── Reading progress bar ───────────────────────────── */

  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 100;
    pointer-events: none;
  }

  .reading-bar {
    height: 100%;
    width: 0%;
    background: var(--color-lime);
    box-shadow: 0 0 10px rgba(29, 185, 84, 0.6);
    transition: width 0.08s linear;
  }

  /* ─── Hero meta ──────────────────────────────────────── */

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-m);
    font-size: 0.88rem;
    color: rgba(245, 247, 246, 0.62);
  }

  .meta-sep { color: rgba(245, 247, 246, 0.45); }

  .meta-read {
    color: var(--color-lime);
  }

  .article-hero-tags {
    margin-top: var(--space-s);
  }

  .eyebrow-link:hover {
    color: var(--color-lime-bright);
  }

  .page-hero .hero-title {
    max-width: 22ch;
  }

  /* Chips on the dark hero */
  .article-hero .chip {
    border-color: rgba(29, 185, 84, 0.35);
    background: rgba(29, 185, 84, 0.12);
    color: var(--color-lime);
  }

  .no-cover {
    margin-top: 0;
  }

  .article-band.no-cover .article-prose {
    margin-top: var(--space-l);
  }

  .article-hero:has(+ .no-cover) {
    padding-bottom: clamp(2.5rem, 5vw, 5rem);
  }

  /* Room at the bottom for the cover image to overlap */
  .article-hero {
    min-height: 0;
    padding-bottom: calc(var(--space-xl) + var(--space-l));
  }

  /* ─── Article: centred reading column on the light page ─ */

  .article-band {
    --reading-width: 68ch;
    margin-top: calc(-1 * var(--space-xl));
    position: relative;
  }

  /* Cover overlaps the bottom of the hero, capped at its native-ish width */
  .article-cover-wrap {
    margin: 0 auto;
    max-width: 960px;
    width: calc(100% - 2 * var(--space-l));
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--color-charcoal);
    border: 1px solid var(--line);
  }

  .article-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .article-cover-wrap.is-logo {
    max-width: 520px;
    aspect-ratio: 4 / 3;
    background: #ffffff;
    padding: var(--space-l);
  }

  .article-cover-wrap.is-logo .article-cover {
    object-fit: contain;
  }

  .article-prose {
    max-width: var(--reading-width);
    margin: var(--space-xl) auto 0;
    font-size: 1.1rem;
    gap: var(--space-m);
  }

  .article-prose :global(p),
  .article-prose :global(li) {
    line-height: 1.75;
  }

  .article-prose :global(h2) {
    font-size: 1.6rem;
    margin-top: var(--space-m);
  }

  .article-prose :global(h3) {
    font-size: 1.25rem;
    margin-top: var(--space-s);
  }

  /* ─── Prose enhancements ─────────────────────────────── */

  /* Blockquotes — dramatic pull-quote style */
  .article-prose :global(blockquote) {
    position: relative;
    margin: var(--space-l) 0;
    padding: var(--space-m) var(--space-l);
    border-left: 3px solid var(--color-lime);
    background: rgba(3, 122, 47, 0.06);
    border-radius: 0 var(--radius-s) var(--radius-s) 0;
  }

  .article-prose :global(blockquote)::before {
    content: '\201C';
    position: absolute;
    top: -0.6rem;
    left: var(--space-m);
    font-family: var(--font-display);
    font-size: 5rem;
    line-height: 1;
    color: rgba(3, 122, 47, 0.2);
    pointer-events: none;
  }

  .article-prose :global(blockquote p) {
    font-size: 1.15rem;
    font-style: italic;
    color: var(--text);
    line-height: 1.65;
  }

  .article-prose :global(strong) {
    color: var(--text);
  }

  /* ─── Article footer ─────────────────────────────────── */

  .article-footer {
    max-width: var(--reading-width);
    margin: var(--space-xl) auto 0;
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }

  .footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    flex-wrap: wrap;
  }

  .back-link {
    font-size: 0.95rem;
    color: var(--color-lime);
    font-weight: 600;
    transition: color var(--transition);
  }

  .back-link:hover {
    color: var(--color-lime);
  }

  /* ─── Copy link button ───────────────────────────────── */

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.45rem 1rem;
    font-family: var(--font-display);
    font-size: 0.88rem;
    color: var(--text);
    cursor: pointer;
    transition: background var(--transition), border-color var(--transition), color var(--transition);
  }

  .copy-btn:hover {
    border-color: var(--color-lime);
    color: var(--color-lime);
  }

  .copy-btn.copied {
    background: rgba(3, 122, 47, 0.08);
    border-color: var(--color-lime);
    color: var(--color-lime);
  }

  /* ─── More posts ─────────────────────────────────────── */

  .more-posts {
    /* Run straight into the footer */
    margin-bottom: calc(-1 * var(--space-2xl));
  }

  .more-all {
    color: rgba(245, 247, 246, 0.72);
    font-size: 0.95rem;
    font-weight: 600;
    white-space: nowrap;
    transition: color var(--transition);
  }

  .more-all:hover {
    color: var(--color-lime);
  }

  .more-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m);
    position: relative;
  }

  /* ─── Scroll to top ──────────────────────────────────── */

  .scroll-top {
    position: fixed;
    bottom: var(--space-l);
    right: var(--space-l);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-lime);
    color: var(--color-ink);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    transition: opacity 0.3s, transform 0.3s, background var(--transition);
    z-index: 50;
    pointer-events: none;
  }

  .scroll-top.visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .scroll-top:hover {
    background: var(--color-lime-bright);
    transform: translateY(-2px);
  }

  /* ─── Responsive ─────────────────────────────────────── */

  @media (max-width: 720px) {
    .article-band {
      margin-top: calc(-1 * var(--space-l));
    }

    .article-cover-wrap {
      width: calc(100% - 2 * var(--space-s));
    }

    .article-prose {
      font-size: 1.05rem;
      margin-top: var(--space-l);
    }

    .more-grid {
      grid-template-columns: 1fr;
    }

    .scroll-top {
      bottom: var(--space-m);
      right: var(--space-m);
    }
  }
</style>

<script>
  declare const gtag: (...args: unknown[]) => void;

  /* ─── Reading progress ───────────────────────────────── */
  const bar = document.getElementById('reading-bar');
  const articleBody = document.getElementById('article-body');

  if (bar && articleBody) {
    const depthFired = new Set<number>();
    const updateProgress = () => {
      const top = articleBody.getBoundingClientRect().top + window.scrollY;
      const progress = Math.min(Math.max((window.scrollY - top) / articleBody.offsetHeight, 0), 1);
      bar.style.width = `${progress * 100}%`;
      [25, 50, 75, 100].forEach((milestone) => {
        if (!depthFired.has(milestone) && progress * 100 >= milestone) {
          depthFired.add(milestone);
          if (typeof gtag !== 'undefined') {
            gtag('event', 'scroll_depth', {
              event_category: 'Blog',
              event_label: document.title,
              percent_scrolled: milestone
            });
          }
        }
      });
    };
    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  }

  /* ─── Scroll-to-top button ───────────────────────────── */
  const scrollBtn = document.getElementById('scroll-top');
  if (scrollBtn) {
    window.addEventListener('scroll', () => {
      scrollBtn.classList.toggle('visible', window.scrollY > 400);
    }, { passive: true });
    scrollBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  }

  /* ─── Copy link button ───────────────────────────────── */
  const copyBtn = document.getElementById('copy-link');
  if (copyBtn) {
    const label = copyBtn.querySelector('.copy-label');
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyBtn.classList.add('copied');
        if (label) label.textContent = 'Copied!';
        if (typeof gtag !== 'undefined') {
          gtag('event', 'share', { method: 'copy_link', content_type: 'blog_post', item_id: window.location.pathname });
        }
        setTimeout(() => {
          copyBtn.classList.remove('copied');
          if (label) label.textContent = 'Copy link';
        }, 2000);
      } catch {
        // Clipboard not available — silently ignore
      }
    });
  }

</script>
