---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import BlogCard from '../../components/BlogCard.astro';
import { createBreadcrumbJsonLd } from '../../lib/seo';
import { requirePageEntry } from '../../lib/pages';

const blogPage = await requirePageEntry('blog');
const { Content } = await render(blogPage);

const posts = (await getCollection('blog', ({ data }) => !data.draft && !data.noindex)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const breadcrumbs = createBreadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' }
]);
---

<BaseLayout
  title={blogPage.data.seoTitle ?? blogPage.data.title}
  description={blogPage.data.seoDescription ?? blogPage.data.description}
  canonical={blogPage.data.canonicalUrl ?? '/blog/'}
  image={blogPage.data.ogImage}
  noindex={blogPage.data.noindex}
  structuredData={[breadcrumbs]}
>
  <PageHero eyebrow="Club Updates" title={blogPage.data.title} summary={blogPage.data.description} />

  <section class="blog-intro reveal" data-delay="1">
    <div class="prose">
      <Content />
    </div>
  </section>

  <section class="blog-posts reveal" data-delay="2" aria-labelledby="posts-heading">
    <div class="posts-head">
      <p class="eyebrow">Latest Posts</p>
      <h2 class="section-title" id="posts-heading">Club Updates</h2>
    </div>

    <div class="posts-grid">
      {posts.map((post, i) => <BlogCard post={post} featured={i === 0 && posts.length > 1} />)}
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Intro: the curated blog.md copy as a slim row, list as pills ── */

  .blog-intro {
    margin-top: var(--space-l);
  }

  .blog-intro .prose {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
    color: var(--text-muted);
  }

  .blog-intro .prose :global(p:first-child) {
    flex: 0 0 100%;
    font-size: 1.1rem;
    color: var(--text);
  }

  .blog-intro .prose :global(ul) {
    display: contents;
  }

  .blog-intro .prose :global(li) {
    list-style: none;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    background: rgba(3, 122, 47, 0.08);
    color: var(--color-lime);
    font-size: 0.9rem;
    font-weight: 600;
  }

  /* ─── Posts ─────────────────────────────────────────── */

  .posts-head {
    margin-bottom: var(--space-m);
  }

  .posts-head .eyebrow {
    color: var(--color-lime);
    margin-bottom: var(--space-2xs);
  }

  .posts-head .eyebrow::before {
    background: var(--color-lime);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m);
  }

  @media (max-width: 720px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
