---
import type { EmailOtpType } from '@supabase/supabase-js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { safeNext } from '../../lib/forms';
import { isSupabaseConfigured, serverSupabase } from '../../lib/supabase';

export const prerender = false;

/*
 * Landing point for links in Supabase emails (invites and password resets).
 *
 * Opening the link shows a "Sign in" button; the one-time token is only used
 * when that is pressed. Email security scanners (Outlook, school and work
 * email) open links before the person does, and would otherwise use the token
 * up, leaving them with "link expired".
 */
Astro.response.headers.set('Cache-Control', 'private, no-store');
if (!isSupabaseConfigured) return Astro.redirect('/login/');

const params = Astro.request.method === 'POST' ? await Astro.request.formData() : Astro.url.searchParams;
const tokenHash = String(params.get('token_hash') ?? '');
const type = (params.get('type') ?? '') as EmailOtpType | '';
const code = params.get('code') ? String(params.get('code')) : null;
const next = safeNext(String(params.get('next') ?? ''));
const isInvite = type === 'invite' || type === 'signup';
const isReset = type === 'recovery';
// Invites and resets land on the account page to choose a password.
const destination = isInvite ? '/portal/account/?welcome=1' : isReset ? '/portal/account/?reset=1' : next;

const supabase = serverSupabase(Astro.request, Astro.cookies);

if (Astro.request.method === 'POST' && tokenHash && type) {
  // A sign-in link for a login that hasn't been used yet carries a sign-up
  // token, so verifying it as "magiclink" fails. "email" accepts both.
  const verifyAs: EmailOtpType = type === 'magiclink' || type === 'signup' ? 'email' : type;
  const { error } = await supabase.auth.verifyOtp({ type: verifyAs, token_hash: tokenHash });
  return Astro.redirect(error ? '/login/?error=link' : destination);
}

// Default email templates: Supabase signs the person in on its own page and
// sends them back with the session after a "#", which only the browser can
// read. The script below posts it here.
const accessToken = Astro.request.method === 'POST' ? String(params.get('access_token') ?? '') : '';
const refreshToken = Astro.request.method === 'POST' ? String(params.get('refresh_token') ?? '') : '';
if (accessToken && refreshToken) {
  const { error } = await supabase.auth.setSession({ access_token: accessToken, refresh_token: refreshToken });
  return Astro.redirect(error ? '/login/?error=link' : destination);
}

if (code) {
  // Links that come back via Supabase's own page (the default email templates).
  const { error } = await supabase.auth.exchangeCodeForSession(code);
  return Astro.redirect(error ? '/login/?error=link' : destination);
}

// Nothing in the query string: the session (or an error) may be after the "#".
const fromHash = !tokenHash || !type;
---

<BaseLayout title="Sign in | Fusion FC" description="Fusion FC team hub sign-in." canonical="/auth/confirm/" noindex>
  <section class="confirm section-card">
    <img class="crest" src="/brand/logo.jpeg" alt="" width="56" height="56" />
    <p class="band-eyebrow">Fusion FC team hub</p>
    {fromHash ? (
      <>
        <h1 class="section-title">Signing you in…</h1>
        <form method="post" data-hash-form>
          <input type="hidden" name="access_token" />
          <input type="hidden" name="refresh_token" />
          <input type="hidden" name="type" />
          <input type="hidden" name="next" value={next} />
        </form>
        <noscript><p class="section-copy">Please turn on JavaScript, or <a href="/login/">sign in here</a>.</p></noscript>
      </>
    ) : (
      <>
        <h1 class="section-title">{isInvite ? "You're invited" : isReset ? 'Reset your password' : 'Sign in'}</h1>
        <p class="section-copy">{isInvite ? "Press the button to open the Fusion FC team hub, then choose a password." : isReset ? 'Press the button, then choose a new password.' : 'Press the button to finish signing in.'}</p>
        <form method="post">
          <input type="hidden" name="token_hash" value={tokenHash} />
          <input type="hidden" name="type" value={type} />
          <input type="hidden" name="next" value={next} />
          <button class="button primary" type="submit" autofocus>{isInvite ? 'Open the team hub' : isReset ? 'Continue' : 'Sign in'}</button>
        </form>
      </>
    )}
  </section>
</BaseLayout>

<script>
  // Default-template links: read the session from after the "#" and post it.
  const form = document.querySelector<HTMLFormElement>('[data-hash-form]');
  if (form) {
    const hash = new URLSearchParams(location.hash.slice(1));
    const access = hash.get('access_token');
    const refresh = hash.get('refresh_token');
    history.replaceState(null, '', location.pathname + location.search); // keep tokens out of history
    if (access && refresh) {
      form.access_token.value = access;
      form.refresh_token.value = refresh;
      form.elements.namedItem('type') && ((form.elements.namedItem('type') as HTMLInputElement).value = hash.get('type') ?? '');
      form.submit();
    } else {
      location.replace('/login/?error=link');
    }
  }
</script>

<style>
  .confirm { max-width: 440px; margin: var(--space-xl) auto 0; text-align: center; }
  .crest { border-radius: 12px; margin: 0 auto var(--space-s); display: block; }
  form { margin-top: var(--space-m); }
  .primary { border: 0; cursor: pointer; width: 100%; }
</style>
