---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { createBreadcrumbJsonLd } from '../lib/seo';
import { requirePageEntry } from '../lib/pages';

const homePage = await requirePageEntry('home');
const { Content } = await render(homePage);

const teams = await getCollection('teams', ({ data }) => !data.noindex);
const leagues = await getCollection('leagues', ({ data }) => !data.noindex);

const breadcrumbs = createBreadcrumbJsonLd([{ name: 'Home', path: '/' }]);
---

<BaseLayout
  title={homePage.data.seoTitle ?? 'Fusion FC Grassroots Football Community'}
  description={homePage.data.seoDescription ?? homePage.data.description}
  canonical={homePage.data.canonicalUrl ?? '/'}
  image={homePage.data.ogImage}
  noindex={homePage.data.noindex}
  structuredData={[breadcrumbs]}
>
  <PageHero
    eyebrow="Fusion Football Club"
    title="Where players grow. Where people belong."
    summary="Fusion Football Club is built around one simple idea: football should help young people develop—not just as players, but as people. Whether it's their first session or they've been playing for years, we create a space where every child can grow in confidence, ability, and love for the game."
    actions={[
      { href: '/join/', label: 'Join Us' },
      { href: '/about/', label: 'Discover the Club', ghost: true },
      { href: '/new-sponsors/', label: 'Sponsor Us', ghost: true }
    ]}
  />

  <!-- Bold stats strip -->
  <section class="stats-strip reveal" data-delay="1">
    <p class="stats-label">Club Snapshot — 2026/27 Season</p>
    <div class="stats-row">
      <div class="stat-item">
        <span class="stat-number" data-count={teams.length}>0</span>
        <span class="stat-name">Active Teams</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-number" data-count={leagues.length}>0</span>
        <span class="stat-name">League Pathways</span>
      </div>
    </div>
  </section>

  <section class="photo-strip reveal" data-delay="2" aria-hidden="true">
    <div class="photo-grid">
      <img class="photo-item" src="/images/session-group-young.jpg" alt="Coach working with young Fusion players" loading="lazy" style="object-position: center 40%" />
      <img class="photo-item" src="/images/players-training-bibs.jpg" alt="Players training together" loading="lazy" style="object-position: center 35%" />
      <img class="photo-item" src="/images/girls-session-evening.jpg" alt="Girls session in action" loading="lazy" style="object-position: 40% center" />
      <img class="photo-item" src="/images/coach-directing.jpg" alt="Fusion coach directing a session" loading="lazy" style="object-position: center 30%" />
    </div>
  </section>

  <section class="section-card reveal" data-delay="3">
    <h2 class="section-title">Inside the Club</h2>
    <div class="prose">
      <Content />
    </div>
    <a class="link-arrow" href="/age-groups/">View age groups</a>
  </section>
</BaseLayout>

<style>
  /* ─── Stats strip ──────────────────────────────────── */

  .stats-strip {
    border-radius: var(--radius-m);
    background: var(--color-ink);
    color: var(--color-paper);
    padding: var(--space-l) var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .stats-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-lime);
  }

  .stats-row {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1;
    color: var(--color-lime);
    font-weight: 700;
  }

  .stat-name {
    font-size: 0.82rem;
    color: rgba(245, 247, 246, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .stat-divider {
    width: 1px;
    height: 52px;
    background: rgba(245, 247, 246, 0.12);
    flex-shrink: 0;
  }

  /* ─── Photo strip ──────────────────────────────────── */

  .photo-strip {
    border-radius: var(--radius-l);
    overflow: hidden;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
    height: 260px;
  }

  .photo-item {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  @media (max-width: 720px) {
    .photo-grid {
      grid-template-columns: repeat(2, 1fr);
      height: 340px;
    }
  }

  @media (max-width: 480px) {
    .photo-grid {
      grid-template-columns: repeat(2, 1fr);
      height: 260px;
    }
  }

  /* ─── Responsive ───────────────────────────────────── */

  @media (max-width: 720px) {
    .stats-strip {
      padding: var(--space-m);
    }

    .stats-row {
      gap: var(--space-l);
    }
  }

  @media (max-width: 500px) {
    .stat-divider {
      height: 36px;
    }
  }
</style>
