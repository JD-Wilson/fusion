---
import { ordinal, type LeagueTable } from '../../lib/matches';

interface Props {
  table: LeagueTable;
  /** Full-Time name of the row to highlight. */
  team?: string;
}
const { table, team } = Astro.props as Props;
const row = team ? table.rows.find((r) => r.team === team) : undefined;
---

<div class="league-table">
  <div class="lt-head">
    <div>
      <p class="lt-division">{table.division}</p>
      <p class="lt-league">{table.league}</p>
    </div>
    {row && <p class="lt-pos"><strong>{ordinal(row.position)}</strong> of {table.rows.length}</p>}
  </div>
  <div class="lt-scroll">
    <table>
      <thead>
        <tr><th>#</th><th class="team">Team</th><th>P</th><th>W</th><th>D</th><th>L</th><th>Pts</th></tr>
      </thead>
      <tbody>
        {table.rows.map((r) => (
          <tr class:list={[r.team === team && 'us']}>
            <td>{r.position}</td>
            <td class="team">{r.team}</td>
            <td>{r.played}</td>
            <td>{r.won}</td>
            <td>{r.drawn}</td>
            <td>{r.lost}</td>
            <td class="pts">{r.points}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  .league-table { border: 1px solid var(--line); border-radius: var(--radius-m); background: var(--surface); overflow: hidden; }
  .lt-head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; padding: 1rem 1.1rem; border-bottom: 1px solid var(--line); }
  .lt-division { font-weight: 600; }
  .lt-league { font-size: 0.82rem; color: var(--text-3); }
  .lt-pos { color: var(--text-2); font-size: 0.9rem; }
  .lt-pos strong { color: var(--accent); font-family: var(--font-display); font-size: 1.3rem; }
  .lt-scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; font-variant-numeric: tabular-nums; }
  th, td { padding: 0.6rem 0.7rem; text-align: center; white-space: nowrap; }
  th { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); }
  td { border-top: 1px solid var(--line); color: var(--text-2); }
  .team { text-align: left; width: 100%; }
  td.team { color: var(--text); }
  .pts { font-weight: 700; color: var(--text); }
  tr.us td { background: var(--accent-soft); color: var(--text); }
  tr.us td.team { font-weight: 600; color: var(--accent); }
</style>
