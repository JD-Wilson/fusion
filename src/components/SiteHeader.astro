---
import { siteConfig } from '../config/site';
import { clubNavLinks } from '../lib/content';

const normalizePath = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const currentPath = normalizePath(Astro.url.pathname);

// A few key destinations stay in the bar; everything lives in the menu.
const barLinks = [
  { href: '/teams/', label: 'Teams' },
  { href: '/fixtures/', label: 'Fixtures' },
  { href: '/vacancies/', label: 'Vacancies' },
  { href: '/development-sessions/', label: 'Development' },
  { href: '/about/', label: 'About' }
];

const clubPages = await clubNavLinks();

const menuGroups = [
  {
    title: 'Play',
    links: [
      { href: '/teams/', label: 'Teams' },
      { href: '/fixtures/', label: 'Fixtures & Results' },
      { href: '/vacancies/', label: 'Vacancies' },
      { href: '/age-groups/', label: 'Age Groups' },
      { href: '/development-sessions/', label: 'Development' },
      { href: '/her-game-too/', label: 'Her Game Too' },
      { href: '/leagues/', label: 'Leagues' }
    ]
  },
  {
    title: 'Club',
    links: [{ href: '/about/', label: 'About' }, ...clubPages]
  },
  {
    title: 'Get involved',
    links: [
      { href: '/join/', label: 'Join Us' },
      { href: '/new-sponsors/', label: 'Sponsor Us' },
      { href: '/blog/', label: 'Blog' },
      { href: '/contact/', label: 'Contact' }
    ]
  }
];

const isActive = (href: string) => currentPath.startsWith(normalizePath(href));
---

<header class="site-header" data-open="false">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Fusion FC home">
      <img src="/brand/logo.jpeg" alt="" width="38" height="38" />
      <span>Fusion FC</span>
    </a>

    <nav class="bar-nav" aria-label="Primary">
      {barLinks.map((link) => (
        <a href={link.href} class:list={[isActive(link.href) && 'active']} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="h-join" href="/join/">Join Us</a>
      <button class="menu-toggle" type="button" aria-controls="site-menu" aria-expanded="false">
        <span class="menu-label" data-label>Menu</span>
        <span class="bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div id="site-menu" class="site-menu" hidden>
    <div class="menu-inner">
      <nav class="menu-groups" aria-label="Site">
        {menuGroups.map((group, i) => (
          <div class="menu-group" style={`--i:${i}`}>
            <p class="menu-title">{group.title}</p>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href} class:list={[isActive(link.href) && 'active']}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>

      <div class="menu-foot">
        <a class="menu-email" href={`mailto:${siteConfig.clubContactEmail}`}>{siteConfig.clubContactEmail}</a>
        <a class="menu-login" href="/login/">Manager login</a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = header?.querySelector<HTMLElement>('#site-menu');
  const label = toggle?.querySelector<HTMLElement>('[data-label]');

  if (header && toggle && menu && label) {
    const setOpen = (open: boolean) => {
      header.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Close' : 'Menu';
      menu.hidden = !open;
      // While the menu is open, the page behind it can't be tabbed to or read out.
      for (const el of document.body.children) if (!el.contains(header)) (el as HTMLElement).inert = open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
    };

    toggle.addEventListener('click', () => setOpen(header.dataset.open !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.dataset.open === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  /*
   * The blurred glass lives on a pseudo-element: a backdrop-filter on the
   * header itself would become the containing block for the fixed menu.
   */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    isolation: isolate;
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(9, 11, 10, 0.6);
    backdrop-filter: saturate(160%) blur(18px);
    -webkit-backdrop-filter: saturate(160%) blur(18px);
    border-bottom: 1px solid transparent;
    transition: background var(--transition), border-color var(--transition);
  }

  .site-header.scrolled::before {
    background: rgba(9, 11, 10, 0.88);
    border-bottom-color: var(--line);
  }

  .site-header[data-open='true']::before {
    background: var(--bg);
    border-bottom-color: var(--line);
  }

  .header-inner {
    width: min(var(--container), calc(100vw - 48px));
    height: var(--header-h);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .brand img {
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--line-strong);
  }

  /* ─── Bar links: plain text, quiet underline on the current page ── */

  .bar-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .bar-nav a {
    position: relative;
    padding: 0.4rem 0;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-2);
    transition: color var(--transition);
  }

  .bar-nav a:hover,
  .bar-nav a.active {
    color: var(--text);
  }

  .bar-nav a.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }

  /* ─── Right side ────────────────────────────────────── */

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
  }

  .h-join {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 1.1rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background var(--transition);
  }

  .h-join:hover { background: var(--color-lime-bright); }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 40px;
    padding: 0 0.95rem 0 1.05rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background var(--transition), border-color var(--transition);
  }

  .menu-toggle:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .bars {
    display: grid;
    gap: 5px;
    width: 14px;
  }

  .bars span {
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.25s ease;
  }

  [data-open='true'] .bars span:first-child { transform: translateY(3.25px) rotate(45deg); }
  [data-open='true'] .bars span:last-child { transform: translateY(-3.25px) rotate(-45deg); }

  /* ─── Full-screen menu ──────────────────────────────── */

  .site-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    overflow-y: auto;
    background: var(--bg);
    animation: menu-in 0.25s ease;
  }

  .menu-inner {
    width: min(var(--container), calc(100vw - 48px));
    min-height: 100%;
    margin: 0 auto;
    padding: clamp(2rem, 6vh, 4rem) 0 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .menu-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .menu-group {
    animation: menu-up 0.35s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 50ms + 40ms);
  }

  .menu-title {
    margin-bottom: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .menu-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }

  .menu-group a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.3rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--text);
    transition: color var(--transition), transform var(--transition);
  }

  .menu-group a:hover {
    color: var(--accent);
    transform: translateX(4px);
  }

  .menu-group a.active { color: var(--accent); }

  .menu-foot {
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.92rem;
  }

  /* Comfortable touch targets for the footer links. */
  .menu-email, .menu-login { display: inline-flex; align-items: center; min-height: 44px; }
  .menu-email { color: var(--text-2); overflow-wrap: anywhere; }
  .menu-email:hover { color: var(--text); }
  .menu-login { color: var(--text-3); }
  .menu-login:hover { color: var(--text); }

  @keyframes menu-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes menu-up { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

  /* ─── Responsive ────────────────────────────────────── */

  @media (max-width: 900px) {
    .bar-nav { display: none; }
    .menu-groups { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 560px) {
    .header-inner,
    .menu-inner { width: calc(100vw - 32px); }
    .header-inner { gap: 0.75rem; }
    .header-actions { gap: 0.5rem; }
    /* 44px touch targets (WCAG 2.5.5, Apple HIG). */
    .h-join { height: 44px; padding: 0 1rem; }
    /* Visually hidden but still the button's accessible name */
    .menu-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .menu-toggle { width: 44px; height: 44px; padding: 0; justify-content: center; }
    .brand { min-height: 44px; }
    .menu-groups { grid-template-columns: 1fr; gap: 2rem; }
    .menu-group a { font-size: 1.5rem; }
  }

  /* Very narrow screens (e.g. folded phones): the crest alone, so nothing crowds.
     The link keeps its "Fusion FC home" name for screen readers. */
  @media (max-width: 319px) {
    .brand span { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-menu, .menu-group { animation: none; }
    .bars span, .menu-group a { transition: none; }
  }
</style>
