---
import { siteConfig } from '../config/site';
import { clubNavLinks } from '../lib/content';

const year = new Date().getFullYear();

const footerLinks = [
  { href: '/about/', label: 'About the Club' },
  { href: '/teams/', label: 'Teams' },
  { href: '/fixtures/', label: 'Fixtures & Results' },
  { href: '/vacancies/', label: 'Vacancies' },
  { href: '/age-groups/', label: 'Age Groups' },
  { href: '/development-sessions/', label: 'Development Sessions' },
  { href: '/leagues/', label: 'Leagues' },
  { href: '/join/', label: 'Join Us' },
  { href: '/blog/', label: 'Blog' },
  { href: '/new-sponsors/', label: 'Become a Sponsor' },
  { href: '/contact/', label: 'Contact Us' },
];

const clubLinks = await clubNavLinks();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="footer-logo" href="/" aria-label="Fusion FC home">
        <img src="/brand/logo.jpeg" alt="" width="44" height="44" loading="lazy" />
        <span class="footer-name">Fusion FC</span>
      </a>
      <p class="footer-tagline">
        Community-first football pathways for players, families, and local partners across the region.
      </p>
      <div class="footer-badge">Est. 2024</div>
    </div>

    <div class="footer-col">
      <h3 class="footer-heading">Quick Links</h3>
      <ul class="footer-nav">
        {footerLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    {clubLinks.length > 0 && (
      <div class="footer-col">
        <ul class="footer-nav footer-nav-club" aria-label="Club information">
          {clubLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    )}

    <div class="footer-col">
      <h3 class="footer-heading">Get in Touch</h3>
      <div class="footer-contact-item">
        <span class="contact-label">Email</span>
        <a href={`mailto:${siteConfig.clubContactEmail}`}>{siteConfig.clubContactEmail}</a>
      </div>
      <a href="/new-sponsors/" class="footer-cta">Sponsor the Club →</a>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {year} Fusion Football Club. All rights reserved.</p>
    <span class="footer-bottom-links">
      <a class="footer-login" href="/club/cookie-policy/" data-cookie-settings>Cookie settings</a>
      <a class="footer-login" href="/login/">Manager login</a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--line);
    background: #070908;
    color: var(--text);
  }

  .footer-inner {
    width: min(var(--container), calc(100vw - 48px));
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 5rem) 0 clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }

  .footer-logo img {
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--line-strong);
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .footer-tagline {
    margin-top: 1rem;
    max-width: 34ch;
    color: var(--text-2);
    font-size: 0.95rem;
  }

  .footer-badge {
    display: inline-flex;
    margin-top: 1.2rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-2);
  }

  .footer-heading {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 1rem;
  }

  /* Second list lines up with the first under the shared heading */
  .footer-nav-club {
    margin-top: calc(0.75rem * 1.1 + 1rem) !important;
  }

  .footer-nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .footer-nav a,
  .footer-contact-item a {
    font-size: 0.93rem;
    color: var(--text-2);
    transition: color var(--transition);
  }

  .footer-nav a:hover,
  .footer-contact-item a:hover { color: var(--text); }

  .footer-contact-item {
    display: grid;
    gap: 0.2rem;
  }

  .contact-label {
    font-size: 0.8rem;
    color: var(--text-3);
  }

  .footer-cta {
    display: inline-flex;
    margin-top: 1.4rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--accent-line);
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--accent);
    transition: background var(--transition);
  }

  .footer-cta:hover { background: var(--accent-soft); }

  .footer-bottom {
    width: min(var(--container), calc(100vw - 48px));
    margin: 0 auto;
    padding: 1.4rem 0 2rem;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-login {
    font-size: 0.82rem;
    color: var(--text-3);
    transition: color var(--transition);
  }

  .footer-login:hover { color: var(--text); }

  .footer-bottom-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .footer-bottom p {
    font-size: 0.82rem;
    color: var(--text-3);
  }

  @media (max-width: 900px) {
    .footer-inner { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
    .footer-nav-club { margin-top: 0 !important; }
  }

  @media (max-width: 560px) {
    .footer-inner,
    .footer-bottom { width: calc(100vw - 32px); }
    .footer-inner { grid-template-columns: 1fr; }
  }
</style>
