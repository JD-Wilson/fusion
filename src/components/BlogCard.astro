---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  /** Wide, side-by-side layout for the newest post */
  featured?: boolean;
}

const { post, featured = false } = Astro.props as Props;
const href = `/blog/${post.id}/`;
const date = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
// Cards show the lead tag only; the full list stays on the post page
const leadTag = post.data.tags[0];
---

<article class:list={['dark-card', 'post-card', featured && 'post-card--featured']}>
  <a href={href} class="post-cover-link" tabindex="-1" aria-hidden="true">
    <img src={post.data.coverImage} alt="" class="post-cover" loading="lazy" />
  </a>
  <div class="post-body">
    <p class="post-meta">
      <time datetime={post.data.date.toISOString()}>{date}</time>
      {leadTag && <span class="chip">{leadTag}</span>}
    </p>
    <h3 class="post-title">
      <a href={href}>{post.data.title}</a>
    </h3>
    <p class="post-excerpt">{post.data.excerpt}</p>
    <a class="link-arrow" href={href}>Read post</a>
  </div>
</article>

<style>
  .post-card {
    padding: 0;
    display: grid;
    align-content: start;
  }

  .post-cover-link {
    display: block;
    overflow: hidden;
  }

  .post-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .post-card:hover .post-cover {
    transform: scale(1.03);
  }

  .post-body {
    padding: var(--space-m);
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: rgba(245, 247, 246, 0.65);
  }

  .post-title {
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .post-title a {
    color: var(--color-paper);
    transition: color var(--transition);
  }

  .post-title a:hover {
    color: var(--color-lime);
  }

  .post-excerpt {
    font-size: 0.95rem;
    color: rgba(245, 247, 246, 0.68);
    line-height: 1.6;
  }

  /* ─── Featured ──────────────────────────────────────── */

  .post-card--featured {
    grid-column: 1 / -1;
    grid-template-columns: 1.3fr 1fr;
    align-items: stretch;
  }

  .post-card--featured .post-cover-link,
  .post-card--featured .post-cover {
    height: 100%;
  }

  .post-card--featured .post-body {
    padding: var(--space-l);
    align-content: center;
  }

  .post-card--featured .post-title {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
  }

  .post-card--featured .post-excerpt {
    font-size: 1.02rem;
  }

  @media (max-width: 720px) {
    .post-card--featured {
      grid-template-columns: 1fr;
    }

    .post-card--featured .post-cover {
      height: auto;
    }

    .post-card--featured .post-body {
      padding: var(--space-m);
    }
  }
</style>
