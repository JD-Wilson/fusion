---
import type { TeamSponsor } from '../../lib/team-sponsors';

interface Props {
  sponsor?: TeamSponsor | null;
}
const { sponsor } = Astro.props as Props;
const sp = sponsor ?? null;
---

<div class="two">
  <label>Sponsor's name<input type="text" name="sponsor_name" required maxlength="80" value={sp?.name ?? ''} placeholder="e.g. Smith & Sons Builders" /></label>
  <label>Website (optional)<input type="text" name="sponsor_website" maxlength="300" inputmode="url" value={sp?.website ?? ''} placeholder="www.example.co.uk" /></label>
</div>
<label>
  A line about them (optional)
  <input type="text" name="sponsor_blurb" maxlength="300" value={sp?.blurb ?? ''} placeholder="e.g. Proud kit sponsor for the 2026/27 season" />
</label>
<div class="two">
  <label>
    Logo (optional)
    <input type="file" name="sponsor_logo" accept="image/png,image/jpeg,image/webp" />
    <span class="hint">PNG, JPEG or WebP, up to 2MB. Plain white or clear space around the logo is trimmed automatically.</span>
  </label>
  <label>
    Order
    <input type="number" name="sponsor_order" min="0" max="999" value={sp?.sort_order ?? 100} />
    <span class="hint">Lower numbers show first.</span>
  </label>
</div>
{sp?.logo_url && <label class="check"><input type="checkbox" name="remove_logo" />Remove the current logo</label>}

<script>
  /*
   * Before upload, trim the plain border around a logo (white, or
   * transparent) so square logos with lots of empty space don't show tiny.
   * Keeps a small margin, keeps transparency (saves as PNG) and caps the
   * size at 800px. If anything goes wrong the original file is used.
   */
  async function trimLogo(file: File): Promise<File> {
    if (!/^image\/(jpeg|png|webp)$/.test(file.type)) return file;
    try {
      const bitmap = await createImageBitmap(file);
      const { width: w, height: h } = bitmap;
      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
      ctx.drawImage(bitmap, 0, 0);
      const px = ctx.getImageData(0, 0, w, h).data;
      // The border colour is taken from the top-left corner.
      const [r0, g0, b0, a0] = [px[0]!, px[1]!, px[2]!, px[3]!];
      const plain = (i: number) =>
        a0 < 16 ? px[i + 3]! < 16 : Math.abs(px[i]! - r0) + Math.abs(px[i + 1]! - g0) + Math.abs(px[i + 2]! - b0) < 40 && px[i + 3]! > 200;
      let top = h, left = w, right = -1, bottom = -1;
      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          if (plain((y * w + x) * 4)) continue;
          if (x < left) left = x;
          if (x > right) right = x;
          if (y < top) top = y;
          if (y > bottom) bottom = y;
        }
      }
      if (right < 0) return file; // all one colour
      const cw = right - left + 1;
      const ch = bottom - top + 1;
      if (cw * ch > w * h * 0.85) return file; // hardly any border: leave it
      const margin = Math.round(Math.max(cw, ch) * 0.04);
      const sx = Math.max(0, left - margin), sy = Math.max(0, top - margin);
      const sw = Math.min(w - sx, cw + margin * 2), sh = Math.min(h - sy, ch + margin * 2);
      const scale = Math.min(1, 800 / Math.max(sw, sh));
      const out = document.createElement('canvas');
      out.width = Math.round(sw * scale);
      out.height = Math.round(sh * scale);
      out.getContext('2d')!.drawImage(canvas, sx, sy, sw, sh, 0, 0, out.width, out.height);
      const blob = await new Promise<Blob | null>((resolve) => out.toBlob(resolve, 'image/png'));
      return blob && blob.size < 2 * 1024 * 1024 ? new File([blob], file.name.replace(/\.\w+$/, '') + '.png', { type: 'image/png' }) : file;
    } catch {
      return file;
    }
  }

  document.querySelectorAll<HTMLInputElement>('input[name="sponsor_logo"]').forEach((input) => {
    input.addEventListener('change', async () => {
      const file = input.files?.[0];
      if (!file || input.dataset.trimmed === file.name) return;
      const trimmed = await trimLogo(file);
      if (trimmed === file) return;
      const list = new DataTransfer();
      list.items.add(trimmed);
      input.dataset.trimmed = trimmed.name;
      input.files = list.files;
    });
  });
</script>
