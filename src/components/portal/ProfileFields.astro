---
/* Photo, About me, qualifications and "show on team pages", for My account and People. */
import type { Person } from '../../lib/portal-people';

interface Props {
  person: Pick<Person, 'full_name' | 'photo_url' | 'bio' | 'qualifications' | 'show_on_site'>;
  /** Editing your own profile ("you") rather than someone else's ("they"). */
  self?: boolean;
}
const { person, self = false } = Astro.props as Props;
const initials = person.full_name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]!.toUpperCase()).join('');
const first = person.full_name.split(' ')[0];
---

<div class="profile">
  <div class="pf-photo">
    {person.photo_url ? <img src={person.photo_url} alt="" /> : <span aria-hidden="true">{initials}</span>}
  </div>
  <div class="pf-fields">
    <label>
      {person.photo_url ? 'Replace photo' : 'Add a photo'}
      <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" data-resize />
      <span class="hint">A clear, friendly head-and-shoulders photo works best.</span>
    </label>
    {person.photo_url && <label class="check"><input type="checkbox" name="remove_photo" />Remove the photo</label>}
  </div>
</div>
<label>
  About {self ? 'me' : first} (optional)
  <textarea name="bio" maxlength="300" rows="3" placeholder="e.g. Coaching at Fusion since 2022. Dad of two, Stoke fan, loves a passing game.">{person.bio ?? ''}</textarea>
</label>
<label>
  Qualifications (optional)
  <input type="text" name="qualifications" maxlength="200" value={person.qualifications ?? ''} placeholder="e.g. FA Introduction to Coaching, DBS checked, First Aid" />
</label>
<label class="check">
  <input type="checkbox" name="show_on_site" checked={Boolean(person.show_on_site)} />
  {self ? 'Show me on my team pages' : `Show ${first} on their team pages`} (name, role, photo and the details above)
</label>

<style>
  .profile { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
  .pf-photo {
    flex: none; width: 96px; height: 96px; border-radius: 50%; overflow: hidden; display: grid; place-items: center;
    background: var(--accent-soft); border: 1px solid var(--accent-line); color: var(--accent);
    font-family: var(--font-display); font-weight: 700; font-size: 1.6rem;
  }
  .pf-photo img { width: 100%; height: 100%; object-fit: cover; }
  .pf-fields { display: grid; gap: 0.5rem; flex: 1; min-width: min(220px, 100%); }
</style>
