---
import { responsive } from '../lib/images';
interface Props {
  eyebrow?: string;
  title: string;
  summary: string;
  actions?: { href: string; label: string; ghost?: boolean }[];
  /** Optional full-bleed background photo (decorative). */
  image?: string;
  /** CSS object-position for cropping the photo, e.g. "50% 30%". */
  imagePosition?: string;
  /**
   * "cover" (default): the photo fills the header, darkened from the left
   * behind the text.
   * "fade": the photo stays bright and only the bottom fades to dark behind
   * the title; suits group shots where every face matters.
   */
  layout?: 'cover' | 'fade';
}

const {
  eyebrow = 'Fusion Football Club',
  title,
  summary,
  actions = [],
  image,
  imagePosition = '50% 40%',
  layout = 'cover'
} = Astro.props as Props;
const fade = Boolean(image) && layout === 'fade';
---

<section class:list={['page-hero', image ? 'has-image' : 'no-image', fade && 'fade']}>
  {
    image && (
      <div class="hero-media" aria-hidden="true">
        <img {...responsive(image, 'hero')} alt="" width="1600" height="1067" decoding="async" fetchpriority="high" style={`object-position: ${imagePosition}`} />
      </div>
    )
  }

  <div class="hero-inner">
    <div class="hero-content">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="hero-title">{title}</h1>
      <p class="hero-summary">{summary}</p>

      {
        actions.length > 0 && (
          <div class="hero-actions">
            {actions.map((action) => (
              <a href={action.href} class:list={['button', action.ghost && 'ghost']}>
                {action.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  /* Full-bleed: breaks out of <main> to span the viewport */
  .page-hero {
    position: relative;
    width: 100vw;
    margin: 0 0 0 calc(50% - 50vw);
    margin-top: 0;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    width: min(var(--container), calc(100vw - 48px));
    margin: 0 auto;
    display: flex;
    align-items: flex-end;
    min-height: min(78vh, 680px);
    padding: clamp(5rem, 12vh, 8rem) 0 clamp(3rem, 7vh, 5rem);
  }

  .no-image .hero-inner {
    min-height: 0;
    padding: clamp(4.5rem, 10vh, 7rem) 0 clamp(3rem, 6vh, 4.5rem);
  }

  .hero-content {
    position: relative;
    max-width: 680px;
  }

  .hero-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Photo with a dark scrim so text always reads */
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(9, 11, 10, 0.94) 0%, rgba(9, 11, 10, 0.78) 38%, rgba(9, 11, 10, 0.2) 75%, rgba(9, 11, 10, 0.1) 100%),
      linear-gradient(0deg, var(--bg) 0%, rgba(9, 11, 10, 0) 35%);
  }

  /* Text-only heroes: a single soft accent glow */
  .no-image {
    background:
      radial-gradient(900px 420px at 85% -20%, rgba(63, 209, 127, 0.14), transparent 65%),
      var(--bg);
  }

  /* Fade layout: a taller, bright photo; only the bottom darkens behind the title. */
  .fade .hero-inner {
    min-height: min(86vh, 780px);
  }

  .fade .hero-media::after {
    background: linear-gradient(0deg, var(--bg) 0%, rgba(9, 11, 10, 0.82) 20%, rgba(9, 11, 10, 0.35) 42%, rgba(9, 11, 10, 0) 62%);
  }

  /* Tighter text block that sits low on the photo. */
  .fade .hero-inner {
    padding-bottom: clamp(2rem, 5vh, 3rem);
  }

  .fade .hero-content {
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.5);
  }

  /* A solid pill so it reads on any photo. */
  .fade .eyebrow {
    margin-bottom: 0.7rem;
    background: rgba(9, 11, 10, 0.72);
    backdrop-filter: blur(6px);
    text-shadow: none;
  }

  .fade .hero-title {
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
  }

  .fade .hero-summary {
    margin-top: 0.4rem;
    color: var(--text);
    opacity: 0.85;
  }

  .fade .hero-actions {
    margin-top: 1.2rem;
  }

  @media (max-width: 720px) {
    .hero-actions .button {
      flex: 1 1 auto;
    }
  }
</style>
