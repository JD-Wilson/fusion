---
interface Props {
  eyebrow?: string;
  title: string;
  summary: string;
  actions?: { href: string; label: string; ghost?: boolean }[];
  /** Optional full-bleed background photo (decorative). */
  image?: string;
  /** CSS object-position for cropping the photo, e.g. "50% 30%". */
  imagePosition?: string;
}

const {
  eyebrow = 'Fusion Football Club',
  title,
  summary,
  actions = [],
  image,
  imagePosition = '50% 40%'
} = Astro.props as Props;
---

<section class:list={['page-hero', image ? 'has-image' : 'no-image']}>
  {
    image && (
      <div class="hero-media" aria-hidden="true">
        <img src={image} alt="" width="1600" height="1067" decoding="async" fetchpriority="high" style={`object-position: ${imagePosition}`} />
      </div>
    )
  }

  <div class="hero-inner">
    <div class="hero-content">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="hero-title">{title}</h1>
      <p class="hero-summary">{summary}</p>

      {
        actions.length > 0 && (
          <div class="hero-actions">
            {actions.map((action) => (
              <a href={action.href} class:list={['button', action.ghost && 'ghost']}>
                {action.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  /* Full-bleed: breaks out of <main> to span the viewport */
  .page-hero {
    position: relative;
    width: 100vw;
    margin: 0 0 0 calc(50% - 50vw);
    margin-top: 0;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    width: min(var(--container), calc(100vw - 48px));
    margin: 0 auto;
    display: flex;
    align-items: flex-end;
    min-height: min(78vh, 680px);
    padding: clamp(5rem, 12vh, 8rem) 0 clamp(3rem, 7vh, 5rem);
  }

  .no-image .hero-inner {
    min-height: 0;
    padding: clamp(4.5rem, 10vh, 7rem) 0 clamp(3rem, 6vh, 4.5rem);
  }

  .hero-content {
    position: relative;
    max-width: 680px;
  }

  .hero-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Photo with a dark scrim so text always reads */
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(9, 11, 10, 0.94) 0%, rgba(9, 11, 10, 0.78) 38%, rgba(9, 11, 10, 0.2) 75%, rgba(9, 11, 10, 0.1) 100%),
      linear-gradient(0deg, var(--bg) 0%, rgba(9, 11, 10, 0) 35%);
  }

  /* Text-only heroes: a single soft accent glow */
  .no-image {
    background:
      radial-gradient(900px 420px at 85% -20%, rgba(63, 209, 127, 0.14), transparent 65%),
      var(--bg);
  }

  @media (max-width: 720px) {
    .hero-inner {
      width: calc(100vw - 32px);
      min-height: 0;
      padding: 0 0 2.5rem;
      flex-direction: column;
      align-items: stretch;
    }

    .has-image .hero-inner {
      padding-top: 46vw;
    }

    .no-image .hero-inner {
      padding: 3.5rem 0 2.5rem;
    }

    .hero-media {
      bottom: auto;
      height: 72vw;
    }

    .hero-media::after {
      background: linear-gradient(0deg, var(--bg) 0%, rgba(9, 11, 10, 0.55) 45%, rgba(9, 11, 10, 0.1) 100%);
    }

    .hero-actions .button {
      flex: 1 1 auto;
    }
  }
</style>
