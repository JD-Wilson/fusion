---
import SEOHead from '../components/SEOHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import CookieBanner from '../components/CookieBanner.astro';
import PointerGlow from '../components/PointerGlow.astro';
import '../styles/global.css';
import { createOrganizationJsonLd } from '../lib/seo';
import type { SEOProps } from '../types/seo';

interface LayoutProps extends SEOProps {
  lang?: string;
}

const {
  lang = 'en-GB',
  title,
  description,
  canonical,
  image,
  type,
  publishedTime,
  modifiedTime,
  noindex,
  structuredData = []
} = Astro.props as LayoutProps;

const fullStructuredData = [createOrganizationJsonLd(), ...structuredData];

/*
 * Social sharing card (public/og/, made by `npm run og`). A page's own image
 * wins (blog covers, team photos); otherwise each section has a designed card.
 */
const OG_BY_PATH: Record<string, string> = {
  '/': 'default',
  '/teams/': 'teams',
  '/fixtures/': 'fixtures',
  '/vacancies/': 'vacancies',
  '/join/': 'join',
  '/about/': 'about',
  '/development-sessions/': 'development',
  '/her-game-too/': 'her-game-too',
  '/age-groups/': 'age-groups',
  '/leagues/': 'leagues',
  '/contact/': 'contact',
  '/new-sponsors/': 'sponsors',
  '/blog/': 'blog'
};
const path = Astro.url.pathname;
const sectionCard = OG_BY_PATH[path] ?? (path.startsWith('/teams/') ? 'team' : path.startsWith('/club/') ? 'club' : 'default');
const shareImage = image && image !== '/brand/logo.jpeg' ? image : `/og/${sectionCard}.jpg`;

// Public pages: cache briefly at the edge so the site stays fast, while
// portal edits still show within a couple of minutes. Pages that set their
// own policy (login, team pages…) keep it.
if (!Astro.response.headers.has('Cache-Control')) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=600');
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090b0a" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <!-- Self-hosted fonts (src/styles/fonts.css); preload the main Latin files -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Scroll animations only hide content once this script has run, and a
      // failsafe shows everything if the animation script never starts.
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!window.__revealReady) document.documentElement.classList.remove('js');
      }, 2500);
    </script>
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      image={shareImage}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      noindex={noindex}
      structuredData={fullStructuredData}
    />
  </head>
  <body>
    <PointerGlow />
    <a class="skip-link" href="#content">Skip to content</a>
    <SiteHeader />
    <main id="content">
      <slot />
    </main>
    <SiteFooter />
    <CookieBanner />
  </body>
</html>

<script>
  /* ─── Scroll-triggered reveals ──────────────────────── */
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
  (window as unknown as { __revealReady: boolean }).__revealReady = true;

  /* ─── Stat counter animation ────────────────────────── */
  function animateCount(el: HTMLElement, target: number) {
    const duration = 1400;
    const start = performance.now();
    const update = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      // Ease out cubic
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = String(Math.round(eased * target));
      if (progress < 1) requestAnimationFrame(update);
    };
    requestAnimationFrame(update);
  }

  const statsStrip = document.querySelector('.stats-strip');
  if (statsStrip) {
    const counterObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
              const target = parseInt(el.getAttribute('data-count') ?? '0', 10);
              animateCount(el, target);
            });
            counterObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.6 }
    );
    counterObserver.observe(statsStrip);
  }

  /* ─── Lazy image fade-in ────────────────────────────── */
  document.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => {
    const show = () => img.classList.add('img-loaded');
    if (img.complete && img.naturalHeight !== 0) {
      show();
    } else {
      img.addEventListener('load', show);
      img.addEventListener('error', show);
    }
  });
</script>

<style>
  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    z-index: 999;
    padding: 0.6rem 0.9rem;
    border-radius: 0.5rem;
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .skip-link:focus {
    left: 0.8rem;
    top: 0.8rem;
  }
</style>
